---
// The home page: paste what you have, then one row per input type, the install block, guides and what was
// updated lately. Half the length of the old page and nothing hidden until JavaScript runs.
import Base from "../layouts/Base.astro";
import PasteBox from "../components/PasteBox.astro";
import Terminal from "../components/Terminal.astro";
import InstallBlock from "../components/InstallBlock.astro";
import CopyCommand from "../components/CopyCommand.astro";
import ToolRow from "../components/ToolRow.astro";
import { api, type SearchResult } from "../lib/api";
import { START_INPUTS, inputLabel } from "../lib/format";
import { NO_DOCKER } from "../lib/install";
import { cacheFor } from "../lib/page";
import { graph, ORGANIZATION } from "../lib/seo";

// "Image" tools take a URL, so that row comes from the images-geo category instead of an input type.
const rowQuery = (t: string) => (t === "image" ? `/tools?kind=tool&category=images-geo&limit=4` : `/tools?kind=tool&input=${t}&limit=4`);
const rowHref = (t: string) => (t === "image" ? "/category/images-geo" : `/input/${t}`);
const byType = await Promise.all(START_INPUTS.map((t) => api<SearchResult>(rowQuery(t)).then((r) => ({ type: t, ...r }))));
const [updated, guides, allTools, allGuides] = await Promise.all([
  api<SearchResult>("/tools?kind=tool&sort=updated&limit=6"),
  api<SearchResult>("/guides?sort=stars&limit=4"),
  api<SearchResult>("/tools?kind=tool&limit=1"),
  api<SearchResult>("/guides?limit=1"),
]);
const totals = { tools: allTools.total ?? 0, guides: allGuides.total ?? 0 };
cacheFor(Astro, 300);
---
<Base
  title="OTInstaller Registry"
  description={`Free, public registry of ${totals.tools} open-source OSINT tools and ${totals.guides} investigation guides. Paste an email, username, phone, domain, IP or URL and run the right tool on your own machine with one command: pinned, signed, scanned and sandboxed.`}
  bleed
  jsonLd={graph(
    { "@type": "WebSite", "@id": `${Astro.site}#website`, name: "OTInstaller Registry", alternateName: "OTInstaller", url: Astro.site?.toString(), publisher: { "@id": ORGANIZATION["@id"] }, potentialAction: { "@type": "SearchAction", target: { "@type": "EntryPoint", urlTemplate: `${Astro.site}search?q={query}` }, "query-input": "required name=query" } },
    ORGANIZATION,
    { "@type": "SoftwareApplication", name: "ot", description: "The OTInstaller command-line tool: installs digest-pinned, signature-verified OSINT tools from the registry and runs them in a locked-down container.", applicationCategory: "SecurityApplication", operatingSystem: "Windows, macOS, Linux", url: `${Astro.site}docs/getting-started`, downloadUrl: "https://github.com/OTInstaller/ot/releases", license: "https://www.apache.org/licenses/LICENSE-2.0", offers: { "@type": "Offer", price: "0", priceCurrency: "USD" }, isAccessibleForFree: true, publisher: { "@id": ORGANIZATION["@id"] } },
  )}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Free public registry of OSINT tools</p>
      <h1>Paste what you have.<br />Run the right tool.</h1>
      <p class="who">A free registry of OSINT tools for investigators, journalists and security teams. One command installs <code>ot</code>; one more runs any tool here in a sandbox on your own machine. <a href="/docs/quick-start">Quick start</a> · <a href="/tour">What you can do</a> · <a href="/agents">For AI agents</a></p>
      <PasteBox id="hero-q" large />
      <p class="starts small muted">or start from:
        {START_INPUTS.map((t) => <a class="chip" href={rowHref(t)}>{inputLabel(t)}</a>)}
      </p>
      <div class="hero-grid">
        <Terminal />
        <div class="trust">
          <p><code>ot</code> installs a tool once and runs it on your own machine, in a container that cannot read your files. Before anything is listed here it is:</p>
          <ul>
            <li><b>pinned</b> to one image digest or wheel hash,</li>
            <li><b>signed</b> by its repository's CI and checked before every run,</li>
            <li><b>scanned</b> for vulnerabilities, secrets and malware,</li>
            <li><b>run once</b> in the same sandbox, and health-checked every night,</li>
            <li><b>reviewed</b> by a person the first time a publisher releases.</li>
          </ul>
          <p class="small"><a href="/docs/security">How releases are checked</a> · <a href="https://github.com/OTInstaller/otinstaller" rel="noopener">Source code</a> · by <a href="https://osintverse.com" rel="noopener">OSINTverse</a></p>
        </div>
      </div>
      <div class="stats" aria-label="The registry in numbers">
        <div><b>{totals.tools}</b><span>tools you can run today</span></div>
        <div><b>{totals.guides}</b><span>investigation guides</span></div>
        <div><b>5</b><span>checks on every release</span></div>
        <div><b>0</b><span>host files a tool can read</span></div>
      </div>
    </div>
  </section>

  <section class="section" id="install" aria-labelledby="install-h">
    <div class="wrap install-grid">
      <div>
        <p class="eyebrow">Install ot</p>
        <h2 id="install-h">Three commands to a result.</h2>
        <p class="small muted">You need Docker Desktop or Podman running; tools run in containers. Then <code>ot doctor</code> confirms your machine is ready. Archives, deb and rpm packages are on <a href="https://github.com/OTInstaller/ot/releases" rel="noopener">GitHub Releases</a>; <code>ot self-update</code> keeps it current.</p>
      </div>
      <InstallBlock />
    </div>
  </section>

  <section class="section" aria-labelledby="otlite-h">
    <div class="wrap install-grid">
      <div>
        <p class="eyebrow">No Docker?</p>
        <h2 id="otlite-h">otlite: one CLI for popular open-source tools.</h2>
        <p class="small muted">On Linux or macOS without Docker, otlite installs, runs, updates and removes 47 curated tools, each in its own virtualenv, with all API keys in one place and every result saved and sortable. <a href="/otlite">About otlite →</a></p>
      </div>
      <CopyCommand command={NO_DOCKER.command} label="Install otlite" />
    </div>
  </section>

  <section class="section" aria-labelledby="have-h">
    <div class="wrap">
      <div class="section-head"><h2 id="have-h">I have a…</h2><a href="/search">All {totals.tools} tools →</a></div>
      <div class="types">
        {byType.map((row) => {
          const label = inputLabel(row.type);
          const more = (row.total ?? row.results.length) - row.results.length;
          return (
            <div class="type-row">
              <a class="label" href={rowHref(row.type)}>{label}</a>
              <span class="list">
                {row.results.length === 0
                  ? <span class="muted">None yet. <a href="/publish">Publish one</a>.</span>
                  : row.results.map((t) => <a href={`/${t.namespace}/${t.name}`} title={`${t.namespace}/${t.name}: ${t.summary}`}><span class="ns">{t.namespace}/</span>{t.name}</a>)}
              </span>
              <a class="more" href={rowHref(row.type)}>{more > 0 ? `${more} more →` : "where it leads →"}</a>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {guides.results.length > 0 && (
    <section class="section" aria-labelledby="guides-h">
      <div class="wrap">
        <div class="section-head"><h2 id="guides-h">Guides</h2><a href="/guides">All {totals.guides} guides →</a></div>
        <div class="rows">{guides.results.map((g) => <ToolRow tool={g} />)}</div>
        <p class="small muted after">Read them here or in a terminal: <code>ot guide read ns/name</code>. <code>ot guide tools ns/name</code> installs everything a guide uses.</p>
      </div>
    </section>
  )}

  {updated.results.length > 0 && (
    <section class="section" aria-labelledby="fresh-h">
      <div class="wrap">
        <div class="section-head"><h2 id="fresh-h">Recently updated</h2><a href="/search?sort=updated">Newest first →</a></div>
        <div class="rows">{updated.results.map((t) => <ToolRow tool={t} />)}</div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="pub-h">
    <div class="wrap">
      <div class="section-head"><h2 id="pub-h">Publish from the repository you already have</h2><a href="/publish">How publishing works →</a></div>
      <div class="row">
        <a class="btn" href="/import">Import a repository</a>
        <a class="btn" href="/docs/publishing">Add a manifest with <code>ot init</code></a>
        <a class="btn" href="/docs/guides">Write a guide</a>
      </div>
      <p class="small muted after">Push a <code>vX.Y.Z</code> tag; the registry validates, scans, backs up and publishes. A person reviews every new publisher's first release, usually within 3 business days.</p>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 48px 0 40px; }
  .hero .eyebrow { margin: 0; }
  .hero h1 { font-size: var(--fs-7); line-height: 1.1; margin: 12px 0 12px; max-width: 22ch; }
  .who { margin: 0 0 20px; max-width: 72ch; color: var(--text-muted); font-size: var(--fs-3); }
  .starts { display: flex; gap: 8px 6px; flex-wrap: wrap; align-items: center; margin: 12px 0 0; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 32px; align-items: start; margin-top: 40px; }
  .trust { font-size: var(--fs-3); color: var(--text-muted); line-height: 1.6; }
  .trust p { margin: 0; }
  .trust ul { margin: 12px 0; padding-left: 18px; }
  .trust li + li { margin-top: 4px; }
  .trust b { color: var(--text); font-weight: 600; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--border); margin-top: 32px; }
  .stats > div { padding: 16px; border-right: 1px solid var(--border); display: grid; gap: 4px; }
  .stats > div:last-child { border-right: 0; }
  .stats b { font-size: var(--fs-6); font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .stats span { font-size: var(--fs-1); color: var(--text-muted); }
  .install-grid { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 32px; align-items: start; }
  .install-grid h2 { margin: 6px 0 8px; font-size: var(--fs-4); }
  .install-grid .eyebrow, .install-grid p { margin: 0; }
  .install-grid p + p { margin-top: 8px; }
  .types { display: grid; border-top: 1px solid var(--border); }
  .type-row { display: grid; grid-template-columns: 170px minmax(0, 1fr) auto; gap: 16px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--border); }
  .type-row .label { font-weight: 600; text-decoration: none; }
  .type-row .label:hover { text-decoration: underline; }
  .type-row .list { display: flex; gap: 6px 16px; flex-wrap: wrap; }
  .type-row .list a { text-decoration: none; }
  .type-row .list a:hover { text-decoration: underline; }
  .type-row .ns { color: var(--text-faint); }
  .type-row .more { color: var(--text-muted); text-decoration: none; white-space: nowrap; font-size: var(--fs-1); }
  .type-row .more:hover { color: var(--text); text-decoration: underline; }
  .after { margin: 12px 0 0; }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; gap: 24px; }
    .stats { grid-template-columns: 1fr 1fr; }
    .stats > div:nth-child(2n) { border-right: 0; }
    .stats > div:nth-child(-n+2) { border-bottom: 1px solid var(--border); }
    .install-grid { grid-template-columns: 1fr; gap: 16px; }
    .type-row { grid-template-columns: 1fr; gap: 6px; }
    .type-row .more { justify-self: start; }
  }
</style>
