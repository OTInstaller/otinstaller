---
import Base from "../layouts/Base.astro";
import PasteBox from "../components/PasteBox.astro";

Astro.response.status = 404;
---
<Base title="Not found" noindex>
  <div class="nf">
    <p class="eyebrow">404</p>
    <h1>Nothing lives at this address</h1>
    <p class="muted">If you followed a link to a tool, it may have been renamed or removed. Paste the value you have, or search by name.</p>
    <PasteBox id="nf-q" />
    <p class="small muted"><a href="/">Home</a> · <a href="/search">All tools</a> · <a href="/guides">Guides</a> · <a href="/policy/transparency">Removed packages</a></p>
  </div>
</Base>

<style>
  .nf { max-width: 640px; margin: 8vh auto; display: grid; gap: 12px; }
  .nf .eyebrow, .nf h1, .nf p { margin: 0; }
  .nf h1 { font-size: var(--fs-5); }
</style>
