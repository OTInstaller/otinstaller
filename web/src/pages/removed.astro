---
// Shown (with status 410) for a package the registry removed.
import Base from "../layouts/Base.astro";

const why = Astro.url.searchParams.get("why") ?? "This package was removed from the registry.";
Astro.response.status = 410;
---
<Base title="Removed" noindex>
  <div class="rm card fade-in">
    <p class="code" aria-hidden="true">410</p>
    <h1>Removed from the registry</h1>
    <p class="notice bad">{why}</p>
    <p class="muted">Removed packages no longer install, and <code>ot</code> warns anyone who still has them. If you installed it, remove it with <code>ot uninstall</code>.</p>
    <p class="small">Every removal is listed on the <a href="/policy/transparency">transparency page</a> with its reason category.</p>
  </div>
</Base>

<style>
  .rm { max-width: 600px; margin: 6vh auto; padding: 40px 32px; text-align: center; display: grid; gap: 10px; }
  .rm:hover { translate: none; }
  .code { font-family: var(--font-mono); font-size: var(--fs-6); font-weight: 800; letter-spacing: -0.05em; margin: 0; color: var(--bad); line-height: 1; opacity: 0.8; }
  .rm h1 { margin: 0; font-size: var(--fs-4); }
  .rm .notice { text-align: left; }
</style>
