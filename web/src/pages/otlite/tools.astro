---
// /otlite/tools: every tool otlite installs, from web/src/data/otlite-catalog.json, which otlite/scripts/web_catalog.py
// generates from otlite's registry (a test there fails when it is stale). The list itself is OtliteCatalog, which
// /otlite shows too.
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import CopyCommand from "../../components/CopyCommand.astro";
import OtliteCatalog from "../../components/OtliteCatalog.astro";
import catalog from "../../data/otlite-catalog.json";
import { NO_DOCKER } from "../../lib/install";
import { cacheFor } from "../../lib/page";

cacheFor(Astro, 3600);

const tools = catalog.tools;
---
<Base title="otlite tools" description={`All ${tools.length} open-source OSINT tools otlite installs and runs on Linux and macOS, by what they take: usernames, emails, phones, domains, IPs, URLs and names. Each with a command to try.`}>
  <PageHead eyebrow="otlite" title={`${tools.length} tools, one command each`}>
    <p class="muted">Every tool <a href="/otlite">otlite</a> installs, with what it takes and a command to try. Each one installs into its own virtualenv with <code>otlite install NAME</code>. This list is generated from otlite {catalog.otlite}.</p>
  </PageHead>

  <CopyCommand command={NO_DOCKER.command} label="Install otlite" />

  <div class="list">
    <OtliteCatalog />
  </div>
  <p class="small muted after">Missing a tool? Tools are listed when they install cleanly and pass a smoke test, and attack or harassment tools are left out by policy. <a href="https://github.com/OTInstaller/otinstaller/tree/main/otlite" rel="noopener">Suggest one on GitHub →</a></p>
</Base>

<style>
  .list { margin-top: 24px; }
  .after { margin-top: 20px; }
</style>
