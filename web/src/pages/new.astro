---
// What's new: every release, new package, yank and deprecation across the registry, newest first, grouped by day,
// with the feeds that carry the same events. `?before=` pages back (and keeps the page out of search engines).
import Base from "../layouts/Base.astro";
import { api, type RegistryActivity, type RegistryEvent } from "../lib/api";
import { formatDate } from "../lib/format";
import { eventEntry, feedLinks, packageHref } from "../lib/feeds";
import { cacheFor } from "../lib/page";
import { firstWeekSaid, firstWeekTone } from "../lib/first-week";

const beforeRaw = Astro.url.searchParams.get("before");
const before = beforeRaw && /^\d{1,15}$/.test(beforeRaw) ? beforeRaw : null;
const { events, next_before } = await api<RegistryActivity>(`/activity?limit=50${before ? `&before=${before}` : ""}`);
cacheFor(Astro, 300);

const days = new Map<string, RegistryEvent[]>();
for (const e of events) {
  const day = formatDate(e.at);
  days.set(day, [...(days.get(day) ?? []), e]);
}
const label: Record<RegistryEvent["type"], { text: string; tone: string }> = {
  published: { text: "Release", tone: "plain" },
  yanked: { text: "Yanked", tone: "warn" },
  unyanked: { text: "Restored", tone: "plain" },
  deprecated: { text: "Deprecated", tone: "warn" },
  undeprecated: { text: "Back", tone: "plain" },
  transferred: { text: "Moved", tone: "plain" },
  // Community events, when the page asks for them (it doesn't today).
  issue_confirmed: { text: "Confirmed", tone: "warn" },
  issue_fixed: { text: "Fixed", tone: "ok" },
  request_accepted: { text: "Accepted", tone: "plain" },
  request_published: { text: "Requested", tone: "ok" },
};
const badge = (e: RegistryEvent) => (e.type === "published" && e.new_package ? { text: e.kind === "guide" ? "New guide" : "New tool", tone: "ok" } : label[e.type]);
---
<Base title="What's new" description="New OSINT tools and guides, releases, yanks and deprecations in the OTInstaller registry, newest first, with Atom and JSON feeds." feeds={feedLinks()}>
  <div class="new">
    <header class="head">
      <p class="eyebrow">Registry activity</p>
      <h1>What's new</h1>
      <p class="lead">New tools and guides, releases, yanks and deprecations, newest first. Follow along in a feed reader, or with the <a href="https://api.otinstaller.com/v1/activity">activity API</a>.</p>
    </header>

    <div class="grid">
      <ol class="days">
        {events.length === 0 && <li class="muted">Nothing {before ? "earlier than this" : "yet"}.</li>}
        {[...days.entries()].map(([day, list]) => (
          <li class="day">
            <h2>{day}</h2>
            <ul class="events">
              {list.map((e) => {
                const entry = eventEntry(e);
                const b = badge(e);
                return (
                  <li class="event">
                    <span class={`badge ${b.tone}`}>{b.text}</span>
                    <div class="what">
                      <a href={entry.url}>{entry.title}</a>
                      <span class="small muted sum">{e.summary}</span>
                      {e.type === "deprecated" && e.replacement && <span class="small">Use <a href={packageHref(e.kind, e.replacement)}>{e.replacement}</a> instead.</span>}
                      {e.first_week && <span class={`small status ${firstWeekTone(e.first_week)}`}>First week: {firstWeekSaid(e.first_week)}.</span>}
                    </div>
                  </li>
                );
              })}
            </ul>
          </li>
        ))}
      </ol>

      <aside class="panel subscribe" aria-labelledby="sub-h">
        <h2 id="sub-h">Follow along</h2>
        <p class="small">Everything on this page:</p>
        <p class="small links"><a href="/feed.atom">Atom</a> · <a href="/feed.json">JSON Feed</a></p>
        <p class="small">Or just what you care about, by adding <code>/feed.atom</code> (or <code>/feed.json</code>) to:</p>
        <ul class="small">
          <li>a publisher: <code>/osintverse-community/feed.atom</code></li>
          <li>a tool's releases, with their notes: <code>/&lt;publisher&gt;/&lt;tool&gt;/feed.atom</code></li>
          <li>an input type: <a href="/input/email/feed.atom"><code>/input/email/feed.atom</code></a></li>
        </ul>
        <p class="small muted">Installed tools: <code>ot outdated</code> shows what has a newer version (<a href="/docs/updates">keeping tools up to date</a>).</p>
      </aside>
    </div>

    {next_before && <p class="older"><a class="btn btn-sm" href={`/new?before=${next_before}`} rel="nofollow">Older</a></p>}
  </div>
</Base>

<style>
  .new { display: grid; gap: 28px; padding: 24px 0 48px; }
  .head { display: grid; gap: 8px; }
  .head h1, .head p { margin: 0; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 32px; align-items: start; }
  .days, .events { list-style: none; margin: 0; padding: 0; display: grid; }
  .days { gap: 24px; }
  .day h2 { font-size: var(--fs-1); text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-faint); margin: 0 0 8px; font-weight: 600; }
  .events { border-top: 1px solid var(--border); }
  .event { display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: 12px; align-items: baseline; padding: 10px 0; border-bottom: 1px solid var(--border); }
  .event .badge { justify-self: start; }
  .what { display: grid; gap: 2px; min-width: 0; }
  .what a { overflow-wrap: anywhere; }
  .sum { overflow-wrap: anywhere; }
  .subscribe { position: sticky; top: 80px; display: grid; gap: 8px; }
  .subscribe p, .subscribe ul { margin: 0; }
  .subscribe ul { padding-left: 16px; display: grid; gap: 4px; }
  .subscribe code { overflow-wrap: anywhere; }
  .older { margin: 0; }
  @media (max-width: 820px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .subscribe { position: static; order: -1; }
    .event { grid-template-columns: minmax(0, 1fr); gap: 4px; }
  }
</style>
