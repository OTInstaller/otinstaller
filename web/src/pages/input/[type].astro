---
import Base from "../../layouts/Base.astro";
import Results from "../../components/Results.astro";
import { api, type Types } from "../../lib/api";
import { inputLabel } from "../../lib/format";
import { cacheFor, searchFrom } from "../../lib/page";

const type = Astro.params.type!;
const types = await api<Types>("/types");
if (!types.inputs.includes(type)) return new Response(null, { status: 404, statusText: "Not found" });
const { result } = await searchFrom(Astro.url, { kind: "tool", input: type });
const label = inputLabel(type);
cacheFor(Astro, 600);
---
<Base title={`${label} OSINT tools`} description={`OSINT tools that take a ${label.toLowerCase()} as input, ranked by how well they work.`}>
  <h1>{label} OSINT tools</h1>
  <p class="muted">Tools that take a {label.toLowerCase()} and what they find. <a href={`/guides?input=${type}`}>Guides about {label.toLowerCase()} investigations</a>.</p>
  <Results result={result} types={types} fixed={["input"]} />
</Base>
