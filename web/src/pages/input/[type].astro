---
// "I have an email": the landing page for one input type. Tools that take it, guides about it, and where it
// leads (the output types those tools find that other tools take). A pasted `?value=` is shown and carried to
// the tool pages by the browser only; the server never sees or caches it.
import Base from "../../layouts/Base.astro";
import Results from "../../components/Results.astro";
import CompareTable from "../../components/CompareTable.astro";
import ToolRow from "../../components/ToolRow.astro";
import { api, type SearchResult, type Types } from "../../lib/api";
import { entityLabel, inputLabel } from "../../lib/format";
import { cacheFor, searchFrom } from "../../lib/page";
import { GENERIC_INPUTS, INPUT_LANDING } from "../../lib/landing";
import { breadcrumbs, graph, itemList } from "../../lib/seo";
import { feedLinks } from "../../lib/feeds";
import { compareRows } from "../../lib/compare";

const type = Astro.params.type!;
const types = await api<Types>("/types");
if (!types.inputs.includes(type)) return new Response(null, { status: 404, statusText: "Not found" });
const [{ result }, guides, all] = await Promise.all([
  searchFrom(Astro.url, { kind: "tool", input: type }),
  api<SearchResult>(`/guides?input=${encodeURIComponent(type)}&limit=4`).catch(() => ({ results: [] }) as SearchResult),
  // Every tool for the comparison table: one fixed URL per type, so the edge cache keeps one copy.
  api<SearchResult>(`/tools?kind=tool&input=${encodeURIComponent(type)}&limit=100&sort=health`).catch(() => null),
]);
const compared = all ? compareRows(all.results) : [];
const label = inputLabel(type);
const lower = label.toLowerCase();
const article = /^[aeiou]/i.test(lower) ? "an" : "a";
// Where this type leads: output types of these tools that are also input types, so another tool can take them.
const leads = new Map<string, number>();
for (const t of result.results) for (const o of t.outputs) if (types.inputs.includes(o) && o !== type) leads.set(o, (leads.get(o) ?? 0) + 1);
const pivots = [...leads.entries()].sort((a, b) => b[1] - a[1]);
const total = result.total ?? result.results.length;
// The page's copy (lib/landing.ts); generic value types (string, integer…) have none and stay out of search engines.
const copy = INPUT_LANDING[type];
const generic = GENERIC_INPUTS.has(type) || !copy;
const title = copy?.title ?? `${label} OSINT tools`;
const description = copy ? `${copy.description} ${total} ${total === 1 ? "tool" : "tools"} listed today.` : `OSINT tools that take ${article} ${lower}.`;
const typed = { email: "e", username: "u", domain: "d", phone: "p", ip: "ip", url: "url" }[type] ?? null;
const jsonLd = graph(
  { "@type": "CollectionPage", name: title, description, url: `${Astro.site}input/${type}`, isPartOf: { "@type": "WebSite", url: Astro.site?.toString() } },
  breadcrumbs([["Tools", "/search"], [label, `/input/${type}`]]),
  itemList(`${label} OSINT tools`, result.results),
);
cacheFor(Astro, 600);
---
<Base title={title} description={description} noindex={generic} jsonLd={jsonLd} jsonHref={`https://api.otinstaller.com/v1/tools?kind=tool&input=${encodeURIComponent(type)}`} feeds={copy ? feedLinks({ title: `${label} tools`, path: `/input/${type}/feed` }) : undefined}>
  <header class="page-head">
    <p class="eyebrow">I have {article}…</p>
    <h1>{label} OSINT tools</h1>
    <p class="muted lead-line">
      {total} {result.results.length === 1 ? "tool takes" : "tools take"} {article} {lower}<span data-value-note hidden> like <code data-value-text></code></span>. Pick one, and its run command is ready to copy.
      {guides.results.length > 0 && <> New to this? Start with the <a href={`/guides/${guides.results[0]!.namespace}/${guides.results[0]!.name}`}>{guides.results[0]!.title ?? "guide"}</a>.</>}
      {compared.length > 1 && <> <a href="#compare-h">Compare them side by side ↓</a></>}
    </p>
    {copy && <p class="lead-copy">{copy.lead}</p>}
  </header>
  <Results result={result} types={types} fixed={["input"]} />
  {compared.length > 1 && (
    <section class="compare-sec" aria-labelledby="compare-h">
      <div class="section-head"><h2 id="compare-h">{label} tools compared</h2></div>
      <CompareTable rows={compared} label={`${article} ${lower}`} />
    </section>
  )}
  {copy && copy.steps.length > 0 && (
    <section class="how" aria-labelledby="how-h">
      <div class="section-head"><h2 id="how-h">How {article} {lower} investigation usually starts</h2></div>
      <ol class="steps">{copy.steps.map((s) => <li>{s}</li>)}</ol>
      <p class="small muted">Every tool here runs on your machine in a sandbox{typed && <>; <code>ot auto {typed}:…</code> runs all of them on one value and <a href="/docs/results">saves the results</a></>}.</p>
    </section>
  )}
  {pivots.length > 0 && (
    <section class="pivots" aria-labelledby="leads-h">
      <div class="section-head"><h2 id="leads-h">Where {article} {lower} leads</h2></div>
      <p class="small muted">What these tools find, and how many tools take each of those next:</p>
      <p class="row">{pivots.map(([o, n]) => <a class="chip" href={`/input/${o}`}>{entityLabel(o)} ← {n} {n === 1 ? "tool" : "tools"} find it</a>)}</p>
    </section>
  )}
  {guides.results.length > 0 && (
    <section aria-labelledby="guides-h">
      <div class="section-head"><h2 id="guides-h">Guides about {lower} investigations</h2><a href={`/guides?input=${type}`}>All guides →</a></div>
      <div class="rows">{guides.results.map((g) => <ToolRow tool={g} />)}</div>
    </section>
  )}
  {copy && copy.faq.length > 0 && (
    <section class="faq" aria-labelledby="faq-h">
      <div class="section-head"><h2 id="faq-h">Before you run one</h2></div>
      {copy.faq.map(([q, a]) => (
        <details class="qa">
          <summary><h3>{q}</h3></summary>
          <p class="small muted">{a}</p>
        </details>
      ))}
    </section>
  )}
</Base>

<script>
  const value = new URLSearchParams(location.search).get("value");
  if (value) {
    const note = document.querySelector<HTMLElement>("[data-value-note]");
    const text = document.querySelector<HTMLElement>("[data-value-text]");
    if (note && text) {
      text.textContent = value;
      note.hidden = false;
    }
  }
</script>

<style>
  .page-head { margin-bottom: 20px; }
  .page-head .eyebrow { margin: 0; }
  .page-head h1 { margin: 6px 0; }
  .lead-line { margin: 0; max-width: 72ch; }
  .lead-copy { margin: 12px 0 0; max-width: 80ch; font-size: var(--fs-2); line-height: 1.6; color: var(--text-muted); }
  .how, .faq, .pivots, .compare-sec, section[aria-labelledby="guides-h"] { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--border); }
  .steps { margin: 8px 0 12px; padding-left: 22px; max-width: 80ch; display: grid; gap: 6px; }
  .how p { margin: 0; }
  .qa { border-bottom: 1px solid var(--border); padding: 10px 0; }
  .qa summary { cursor: pointer; list-style: none; display: flex; gap: 10px; align-items: baseline; }
  .qa summary::-webkit-details-marker { display: none; }
  .qa summary::before { content: "+"; color: var(--text-faint); flex: none; width: 1ch; }
  .qa[open] summary::before { content: "−"; }
  .qa h3 { display: inline; margin: 0; font-size: var(--fs-2); font-weight: 500; }
  .qa p { margin: 8px 0 0 calc(1ch + 10px); max-width: 80ch; line-height: 1.6; }
  .pivots .section-head, section .section-head { margin-bottom: 8px; }
  .pivots p { margin: 6px 0 0; }
  .pivots .chip { text-transform: none; letter-spacing: 0; font-size: var(--fs-1); height: 28px; }
</style>
