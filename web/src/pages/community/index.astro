---
// /community: where people can help keep the registry working. Broken reports that need someone to confirm them,
// tools that are behind upstream, and wrong information, across every package; plus how to take part.
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import IssueRow from "../../components/IssueRow.astro";
import { api, apiOrNull, type IssueSummary, type RegistryActivity, type UpstreamSummary } from "../../lib/api";
import { eventEntry } from "../../lib/feeds";
import { cacheFor } from "../../lib/page";

const views = [
  { key: "", label: "Open problems", query: "" },
  { key: "confirm", label: "Needs confirming", query: "needs=confirmation" },
  { key: "broken", label: "Broken", query: "kind=broken" },
  { key: "outdated", label: "Outdated", query: "kind=outdated" },
  { key: "wrong_info", label: "Wrong information", query: "kind=wrong_info" },
];
const view = views.find((v) => v.key === (Astro.url.searchParams.get("view") ?? "")) ?? views[0]!;
const before = /^\d{1,15}$/.test(Astro.url.searchParams.get("before") ?? "") ? Astro.url.searchParams.get("before") : null;
const params = [view.query, before ? `before=${before}` : ""].filter(Boolean).join("&");
const [board, upstream, recent] = await Promise.all([
  api<{ issues: (IssueSummary & { ref: string })[]; next_before: number | null }>(`/issues${params ? `?${params}` : ""}`),
  apiOrNull<UpstreamSummary>("/upstream/summary").catch(() => null),
  apiOrNull<RegistryActivity>("/activity?events=community&limit=8").catch(() => null),
]);
cacheFor(Astro, 120);
const link = (key: string) => (key ? `/community?view=${key}` : "/community");
---
<Base title="Community" description="Help keep the OTInstaller registry working: confirm broken tools, report outdated ones and fix wrong information.">
  <PageHead eyebrow="Community" title="Keep the registry working">
    <p class="lead">Everyone who runs these tools finds out first when one breaks, falls behind its upstream, or says something untrue. Here is what needs a hand right now.</p>
  </PageHead>

  <div class="grid">
    <div>
      <nav class="row views" aria-label="What to show">
        {views.map((v) => <a class="chip" href={link(v.key)} aria-current={v.key === view.key ? "page" : undefined} rel={v.key ? "nofollow" : undefined}>{v.label}</a>)}
      </nav>
      {board.issues.length === 0 ? <p class="muted">Nothing here right now.</p> : (
        <ul class="issues">{board.issues.map((i) => <IssueRow issue={i} refName={i.ref} showRef />)}</ul>
      )}
      {board.next_before && <p><a class="btn btn-sm" href={`${link(view.key)}${view.key ? "&" : "?"}before=${board.next_before}`} rel="nofollow">Older</a></p>}
    </div>

    <aside class="panel how" aria-labelledby="how-h">
      <h2 id="how-h">How to help</h2>
      <ul>
        <li><b>Confirm a broken report.</b> Try the tool on its own test input and say whether it fails for you too.</li>
        <li><b>Say it works.</b> "It works for me" on a tool page counts for that version and platform.</li>
        <li><b>Report what's wrong.</b> Every tool page has an Issues tab: broken, outdated, wrong information, feature requests and questions.</li>
        <li><b>Ask for a missing tool.</b> <a href="/requests">Tool requests</a> lists what people want packaged; vote for the ones you'd use.</li>
        <li><b>From the terminal.</b> When <code>ot run</code> fails it asks whether to report it, and <code>ot report &lt;tool&gt; --works</code> says a version works for you. <code>ot issues &lt;tool&gt;</code> lists what others found.</li>
      </ul>
      {recent && recent.events.length > 0 && (
        <>
          <h3 class="behind-h">Recently</h3>
          <ul class="behind">{recent.events.map((e) => { const entry = eventEntry(e); return <li><a href={entry.url}>{entry.title}</a></li>; })}</ul>
        </>
      )}
      {upstream && upstream.behind.length > 0 && (
        <>
          <h3 class="behind-h">Behind upstream</h3>
          <ul class="behind">
            {upstream.behind.slice(0, 8).map((b) => <li><a href={`/${b.ref}`}>{b.ref}</a> <span class="muted">pins {b.pinned}; upstream {b.latest}</span></li>)}
          </ul>
          {upstream.behind.length > 8 && <p class="small muted">And {upstream.behind.length - 8} more.</p>}
        </>
      )}
      <p class="small">Read the <a href="/policy/community">community guidelines</a> first, especially: never post personal data about the people you investigate.</p>
      <p class="small muted"><a href="/docs/community">How the community works</a> · <a href="/community/moderation">Moderation</a> (triagers)</p>
    </aside>
  </div>
</Base>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 32px; align-items: start; }
  .views { margin-bottom: 8px; }
  .views .chip { text-transform: none; letter-spacing: 0; font-size: var(--fs-1); }
  .issues { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .how { position: sticky; top: 80px; }
  .how ul { margin: 0 0 10px; padding-left: 18px; display: grid; gap: 8px; font-size: var(--fs-2); }
  .how p { margin: 0 0 6px; }
  .behind-h { font-size: var(--fs-2); margin: 14px 0 6px; }
  .behind { margin: 0 0 10px; padding-left: 18px; display: grid; gap: 4px; font-size: var(--fs-1); overflow-wrap: anywhere; }
  @media (max-width: 820px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .how { position: static; order: -1; }
  }
</style>
