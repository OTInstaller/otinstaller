---
// The Profile tab for one namespace: what its public page shows and how it stays in sync with GitHub and GitLab.
import Base from "../../../layouts/Base.astro";
import ProfileEditor from "../../../islands/ProfileEditor";

const { ns } = Astro.params as { ns: string };
Astro.response.headers.set("Cache-Control", "private, no-store");
---
<Base title={`Profile of ${ns}`} noindex>
  <header class="page-head">
    <nav class="small crumbs" aria-label="Breadcrumb"><a href="/dashboard">Dashboard</a> <span aria-hidden="true">/</span> profile</nav>
    <h1>{ns}</h1>
  </header>
  <ProfileEditor client:load ns={ns} back={`${Astro.site}dashboard/profile/${ns}`} />
</Base>

<style is:global>
  .page-head { margin-bottom: 20px; }
  .page-head .crumbs { margin: 0 0 8px; color: var(--text-faint); }
  .page-head h1 { margin: 0; }
  .pe h2 { font-size: var(--fs-4); margin: 24px 0 8px; }
  .pe .sync { margin-top: 12px; }
  .pe .fields { display: grid; gap: 1px; background: var(--border); border: 1px solid var(--border); grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
  .pe .field { margin: 0; border: 0; background: var(--bg); padding: 12px 14px; display: grid; gap: 6px; min-width: 0; }
  /* Six fields fill whole rows at one, two or three columns; social links take a full row of their own. */
  .pe .field:last-child { grid-column: 1 / -1; }
  .pe .field legend { float: left; font-weight: 600; font-size: var(--fs-2); margin-bottom: 4px; }
  .pe .field legend + * { clear: left; }
  .pe .field label { gap: 8px; flex-wrap: nowrap; align-items: baseline; }
  .pe .field label .muted { overflow-wrap: anywhere; }
  .pe .field input[type="text"], .pe .field input[type="url"] { width: 100%; }
  .pe .hide { margin-top: 12px; gap: 8px; align-items: baseline; flex-wrap: nowrap; }
  .pe .pins label { flex-wrap: nowrap; align-items: baseline; gap: 8px; }
  .pe .pins .muted { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .pe .preview { border: 1px solid var(--border); padding: 14px; margin-top: 12px; }
  .pe .preview ul { margin: 0 0 12px; padding-left: 28px; }
</style>
