---
// Pages that throw (usually because the registry API is down) land here, with status 500. Without this page Astro
// answered with the 404 page, which told crawlers the home page and every tool were gone while the database was down.
import Base from "../layouts/Base.astro";
import { ApiError } from "../lib/api";

const { error } = Astro.props as { error?: unknown };
Astro.response.headers.set("Retry-After", "300");
Astro.response.headers.set("Cache-Control", "no-store");
const requestId = error instanceof ApiError ? error.message.match(/request ID ([\w-]+)/)?.[1] : undefined;
---
<Base title="Temporarily unavailable" noindex>
  <div class="nf card fade-in">
    <p class="code" aria-hidden="true">500</p>
    <h1>The registry is having trouble</h1>
    <p class="muted">This page couldn't be loaded just now. Nothing is wrong with your setup; please try again in a few minutes.</p>
    {requestId && <p class="small muted">Request ID <code>{requestId}</code></p>}
    <p class="small"><a href="/">Home</a> · <a href="/docs">Docs</a> · <a href="/feedback">Tell us about it</a></p>
  </div>
</Base>

<style>
  .nf { max-width: 560px; margin: 6vh auto; padding: 40px 32px; text-align: center; display: grid; gap: 10px; justify-items: center; }
  .nf:hover { translate: none; }
  .code { font-family: var(--font-mono); font-size: var(--fs-6); font-weight: 800; letter-spacing: -0.05em; margin: 0; background: linear-gradient(120deg, var(--accent), var(--ok)); -webkit-background-clip: text; background-clip: text; color: transparent; line-height: 1; }
  .nf h1 { margin: 0; font-size: var(--fs-4); }
</style>
