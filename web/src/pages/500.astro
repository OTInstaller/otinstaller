---
// Pages that throw (usually because the registry API is down) land here, with status 500. Without this page Astro
// answered with the 404 page, which told crawlers the home page and every tool were gone while the database was down.
import Base from "../layouts/Base.astro";
import { ApiError } from "../lib/api";

const { error } = Astro.props as { error?: unknown };
Astro.response.headers.set("Retry-After", "300");
Astro.response.headers.set("Cache-Control", "no-store");
const requestId = error instanceof ApiError ? error.message.match(/request ID ([\w-]+)/)?.[1] : undefined;
---
<Base title="Temporarily unavailable" noindex>
  <div class="nf">
    <p class="eyebrow">500 · temporarily unavailable</p>
    <h1>The registry is having trouble</h1>
    <p class="muted">This page could not be loaded just now. Nothing is wrong with your setup; please try again in a few minutes. Installed tools keep working, and <code>ot</code> keeps a cache of what it needs.</p>
    {requestId && <p class="small muted">Request ID <code>{requestId}</code></p>}
    <p class="small muted"><a href="/">Home</a> · <a href="/docs">Docs</a> · <a href="/feedback">Tell us about it</a></p>
  </div>
</Base>

<style>
  .nf { max-width: 640px; margin: 8vh auto; display: grid; gap: 12px; }
  .nf .eyebrow, .nf h1, .nf p { margin: 0; }
  .nf h1 { font-size: var(--fs-5); }
</style>
