---
import Base from "../../../layouts/Base.astro";
import ToolHeader from "../../../components/ToolHeader.astro";
import VersionActions from "../../../islands/VersionActions";
import { api, type Version } from "../../../lib/api";
import { formatDate } from "../../../lib/format";
import { loadTool } from "../../../lib/tool";
import { cacheFor } from "../../../lib/page";
import { feedLinks } from "../../../lib/feeds";

const loaded = await loadTool(Astro, "/versions");
if ("response" in loaded) return loaded.response;
const { tool: t, hasDocs } = loaded;
const ref = `${t.namespace}/${t.name}`;
const { versions } = await api<{ versions: Version[] }>(`/tools/${ref}/versions`);
cacheFor(Astro, 60);
const scanClass: Record<string, string> = { pass: "ok", warn: "warn", fail: "bad", pending: "info" };
const scanLabel: Record<string, string> = { pass: "Passed", warn: "Warnings", fail: "Failed", pending: "Pending" };
const tagUrl = (v: string) => (t.repo_url ? `${t.repo_url.replace(/\/$/, "")}/${t.repo_url.includes("gitlab.com") ? "-/tags" : "releases/tag"}/v${v}` : null);
const anyGone = versions.some((v) => v.status === "yanked");
---
<Base title={`${ref} versions`} description={`Version history of ${ref}.`} jsonHref={`https://api.otinstaller.com/v1/tools/${ref}/versions`} feeds={feedLinks({ title: `${ref} releases`, path: `/${ref}/feed` })}>
  <ToolHeader tool={t} active="versions" hasDocs={hasDocs} />
  <p class="small muted intro"><code>ot install {ref}</code> takes the version marked latest; an exact version pins it. Each tag links to the commit the release was built from.</p>
  <div class="table-wrap">
    <table class="data versions">
      <thead><tr><th scope="col">Version</th><th scope="col">Published</th><th scope="col">Scan</th><th scope="col">Signed</th><th scope="col">Tag</th><th scope="col">Install</th></tr></thead>
      <tbody>
        {versions.map((v) => {
          const gone = v.status === "yanked" || v.status === "removed";
          const latest = v.version === t.latest_version && !gone;
          const tag = tagUrl(v.version);
          return (
            <tr class:list={{ latest, gone }}>
              <td class="vcell">
                <code class:list={{ struck: gone }}>{v.version}</code>
                {latest && <span class="badge info">latest</span>}
                {v.status === "yanked" && <span class="badge warn" title={v.yanked_at ? `Yanked ${formatDate(v.yanked_at)}` : undefined}>yanked</span>}
                {v.status === "removed" && <span class="badge bad">removed</span>}
              </td>
              <td>{formatDate(v.published_at)}</td>
              <td><a href={`/${ref}/security?v=${encodeURIComponent(v.version)}`} class={`status ${scanClass[v.scan_status] ?? "none"}`}>{scanLabel[v.scan_status] ?? v.scan_status}</a></td>
              <td>{v.signed ? <span class="status ok">yes</span> : <span class="status none">no</span>}</td>
              <td>{tag ? <a href={tag} rel="nofollow noopener">v{v.version}</a> : <span class="faint">—</span>}</td>
              <td>{v.status === "removed" ? <span class="faint">—</span> : <span class="inst"><code>ot install {ref}@{v.version}</code><button class="btn btn-sm copy" type="button" data-copy={`ot install ${ref}@${v.version}`} aria-label={`Copy install command for ${v.version}`}><span class="label">Copy</span></button></span>}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <VersionActions client:idle refName={ref} versions={versions.map((v) => ({ version: v.version, status: v.status }))} />
  {anyGone && <p class="small muted">Yanked versions stay installable by exact version so existing scripts keep working; they are hidden from search and <code>@latest</code>.</p>}
</Base>

<style>
  .intro { margin: 0 0 12px; }
  .versions td { vertical-align: middle; }
  .vcell { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .latest { background: var(--bg-subtle); }
  .gone { color: var(--text-faint); }
  .status { text-decoration: none; }
  .inst { display: inline-flex; gap: 8px; align-items: center; }
</style>
