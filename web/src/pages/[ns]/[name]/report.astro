---
// /{ns}/{name}/report: the report form, with what happens to a report so reporters know what to expect.
import Base from "../../../layouts/Base.astro";
import ToolHeader from "../../../components/ToolHeader.astro";
import ReportForm from "../../../islands/ReportForm";
import { api, type Version } from "../../../lib/api";
import { loadTool } from "../../../lib/tool";

const loaded = await loadTool(Astro, "/report");
if ("response" in loaded) return loaded.response;
const { tool: t, hasDocs } = loaded;
const ref = `${t.namespace}/${t.name}`;
const { versions } = await api<{ versions: Version[] }>(`/tools/${ref}/versions`);
Astro.response.headers.set("Cache-Control", "private, no-store");
---
<Base title={`Report ${ref}`} noindex>
  <ToolHeader tool={t} active="overview" hasDocs={hasDocs} />
  <div class="two-col">
    <div>
      <h2 class="rt">Report this package</h2>
      <p class="muted">Reports go to the registry's reviewers. You don't need an account; sign in if you want a reply. The <a href="/policy/acceptable-use">acceptable-use policy</a> says what isn't allowed. A bug in the tool itself is better reported to its authors{t.homepage && <> at <a href={t.homepage} rel="nofollow noopener">{t.homepage.replace(/^https?:\/\//, "")}</a></>}.</p>
      <ReportForm client:load refName={ref} versions={versions.filter((v) => v.status !== "removed").map((v) => v.version)} version={Astro.url.searchParams.get("v") ?? undefined} />
    </div>
    <aside class="panel what">
      <h2>What happens next</h2>
      <ol class="small">
        <li>A reviewer reads it within 72 hours, or 24 hours for malware or credible harm.</li>
        <li>Possible actions, in order of weight: dismiss, ask the publisher to fix, yank the version, remove the package, suspend the namespace, ban the account.</li>
        <li>Malware: removal, a warning to everyone who installed it, a suspended namespace, and an advisory on the <a href="/policy/transparency">transparency page</a>.</li>
        <li>Every removal is listed there with its reason category; report counts are published each quarter.</li>
      </ol>
      <p class="small muted">Anonymous reports are rate-limited. For vulnerabilities in the registry or in <code>ot</code> itself, email <a href="mailto:security@otinstaller.com">security@otinstaller.com</a>.</p>
    </aside>
  </div>
</Base>

<style>
  .rt { margin-top: 0; font-size: var(--fs-4); }
  .what h2 { margin: 0 0 8px; }
  .what ol { margin: 0; padding-left: 18px; display: grid; gap: 6px; }
  .what p { margin: 10px 0 0; }
</style>
