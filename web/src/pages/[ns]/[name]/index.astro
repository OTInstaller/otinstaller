---
// A tool's overview: run block, evidence, the facts rail, a sample of what comes back, the README, guides that
// use it, and where its output leads. A `?value=` from an input page fills the run command in the browser only.
import Base from "../../../layouts/Base.astro";
import ToolHeader from "../../../components/ToolHeader.astro";
import Evidence from "../../../components/Evidence.astro";
import InstallBlock from "../../../components/InstallBlock.astro";
import CopyCode from "../../../components/CopyCode.astro";
import ToolRow from "../../../components/ToolRow.astro";
import { apiOrNull, type CommunityStatus, type ManifestResponse, type Pivots, type Scans, type SearchResult } from "../../../lib/api";
import { STATE_TONE } from "../../../lib/community";
import WorksForMe from "../../../islands/WorksForMe";
import { entityLabel, formatDate, inputLabel } from "../../../lib/format";
import { ethicsLines, evidence, inputExample, prefixFor, recordedEnvelope, sampleEnvelope } from "../../../lib/evidence";
import { loadTool } from "../../../lib/tool";
import { cacheFor } from "../../../lib/page";
import { demoteHeadings } from "../../../lib/html";
import { GENERIC_INPUTS } from "../../../lib/landing";
import { article, breadcrumbs, clip, graph } from "../../../lib/seo";

const loaded = await loadTool(Astro);
if ("response" in loaded) return loaded.response;
const { tool: t, hasDocs } = loaded;
const ref = `${t.namespace}/${t.name}`;
const m = t.manifest;
const pivotFrom = (m.outputs ?? []).map((o) => o.type);
const required0 = (m.inputs ?? []).find((i) => i.required && !GENERIC_INPUTS.has(i.type)) ?? (m.inputs ?? []).find((i) => !GENERIC_INPUTS.has(i.type));
const [readme, guides, scans, manifest, latest, pivots, similar, community] = await Promise.all([
  apiOrNull<{ html: string }>(`/tools/${ref}/readme`),
  apiOrNull<{ guides: SearchResult["results"] }>(`/tools/${ref}/guides`),
  apiOrNull<Scans>(`/tools/${ref}/${t.latest_version}/scans`),
  apiOrNull<ManifestResponse>(`/tools/${ref}/${t.latest_version}/manifest`),
  apiOrNull<{ published_at: number | null }>(`/tools/${ref}/${t.latest_version}`),
  pivotFrom.length ? apiOrNull<Pivots>(`/pivots?from=${encodeURIComponent(pivotFrom.join(","))}`).catch(() => null) : Promise.resolve(null),
  // Other tools that take the same thing: the alternatives, and the way to the input landing page.
  required0 ? apiOrNull<SearchResult>(`/tools?kind=tool&input=${encodeURIComponent(required0.type)}&limit=8`).catch(() => null) : Promise.resolve(null),
  // The community status line: the health check, what people said about this version, open issues.
  apiOrNull<CommunityStatus>(`/tools/${ref}/status`).catch(() => null),
]);
const alternatives = (similar?.results ?? []).filter((s) => `${s.namespace}/${s.name}` !== ref).slice(0, 5);
const e = m.ethics;
const lines = evidence(t, scans, manifest);
const required = (m.inputs ?? []).filter((i) => i.required);
const first = required[0];
// Example values come from the manifest (its example, else the registry's own test input), so the command is one
// that has run. A single required input with a typed prefix is written as d:example.com, as the docs teach it.
const ex = (i: { name: string; type: string; example?: unknown }) => inputExample(m, i);
const quote = (v: string) => (/[\s"']/.test(v) ? JSON.stringify(v) : v);
const prefix = required.length === 1 ? prefixFor(required[0]!.type) : null;
const runArgs = prefix ? `${prefix}:${quote(ex(required[0]!))}` : required.map((i) => `--${i.name} ${quote(ex(i))}`).join(" ");
const runCmd = `ot run ${ref}${runArgs ? ` ${runArgs}` : ""} --format table`;
const fromTest = required.some((i) => m.test?.input?.[i.name] != null);
const egress = m.network?.egress === true;
const runtimeLine = [
  m.runtime?.kind === "docker" ? "Docker image in a read-only container" : "Python wheel, run in a read-only container (Docker optional with --native)",
  egress ? (m.network?.domains?.length ? `talks to ${m.network.domains.slice(0, 3).join(", ")}${m.network.domains.length > 3 ? "…" : ""}` : "network allowed") : "no network",
  m.secrets?.some((s) => s.required) ? `needs ${m.secrets.filter((s) => s.required).map((s) => s.name).join(", ")}` : "no key",
  m.runtime?.timeout_seconds ? `up to ${Math.round(m.runtime.timeout_seconds / 60)} min` : null,
].filter(Boolean).join(" · ");
// What an agent sends `ot mcp` to run this tool (docs/agents): one target with its type, or inputs by name.
const agentCall = first
  ? JSON.stringify({ tool: ref, target: ex(first).replace(/^"|"$/g, ""), input_type: first.type })
  : JSON.stringify({ tool: ref });
// Real output first: the scanner records what the manifest's test input produced. Otherwise a sample shaped from
// what the tool declares it finds.
const sampleInput = Object.fromEntries(required.map((i) => [i.name, ex(i).replace(/^"|"$/g, "")]));
const recorded = t.sample ? recordedEnvelope(ref, m.runtime?.kind ?? "docker", m.test?.input ? Object.fromEntries(Object.entries(m.test.input).map(([k, v]) => [k, String(v)])) : sampleInput, t.sample) : null;
const recordedText = !recorded && t.sample?.stdout ? t.sample.stdout : null;
const sample = recorded ?? sampleEnvelope(ref, t.latest_version, m.runtime?.kind ?? "docker", pivotFrom, sampleInput);
const recordedOn = t.sample ? new Date(t.sample.recorded_at).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) : null;
const leads = pivotFrom.filter((o) => pivots?.pivots[o]?.length).map((o) => ({ type: o, n: pivots!.pivots[o]!.length }));
const jsonHref = `https://api.otinstaller.com/v1/tools/${ref}`;
cacheFor(Astro, 60);
// What a search result shows: the tool's name and what it does, then what it takes, finds and needs.
const takes = (m.inputs ?? []).filter((i) => !GENERIC_INPUTS.has(i.type)).map((i) => inputLabel(i.type).toLowerCase());
const finds = pivotFrom.map(entityLabel);
const title = `${t.name}: ${clip(t.summary, 48)}`;
const description = [
  `${t.summary}.`,
  takes.length ? `Takes ${[...new Set(takes)].join(", ")}${finds.length ? `; finds ${finds.slice(0, 4).join(", ")}` : ""}.` : "",
  `Install and run ${t.name} with one command (ot run ${ref}), sandboxed, signature-checked, ${m.secrets?.some((s) => s.required) ? "with your own API key" : "no API key needed"}.`,
].filter(Boolean).join(" ");
const software = {
  "@type": "SoftwareApplication",
  name: t.name,
  alternateName: ref,
  description: t.summary,
  softwareVersion: t.latest_version,
  applicationCategory: "SecurityApplication",
  operatingSystem: "Windows, macOS, Linux",
  license: t.license,
  url: `${Astro.site}${ref}`,
  ...(t.repo_url ? { codeRepository: t.repo_url } : {}),
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  isAccessibleForFree: true,
  featureList: [...(m.inputs ?? []).map((i) => `Input: ${i.type}`), ...(m.outputs ?? []).map((o) => `Finds: ${o.type}`)],
  downloadUrl: "https://otinstaller.com/docs/getting-started",
  installUrl: "https://otinstaller.com/docs/getting-started",
  softwareRequirements: "ot, Docker or Podman",
  ...(latest?.published_at ? { datePublished: new Date(latest.published_at).toISOString() } : {}),
  ...(t.homepage && t.homepage !== t.repo_url ? { sameAs: t.homepage } : {}),
  publisher: { "@type": "Organization", name: t.namespace, url: `${Astro.site}${t.namespace}` },
  keywords: [...new Set([...t.categories, ...takes.map((k) => `${k} OSINT`), "OSINT tool"])].join(", "),
};
const jsonLd = graph(software, breadcrumbs([["Tools", "/search"], [t.namespace, `/${t.namespace}`], [t.name, `/${ref}`]]));
---
<Base title={title} description={description} jsonLd={jsonLd} jsonHref={jsonHref} markdown={`/${ref}.md`}>
  <ToolHeader tool={t} active="overview" hasDocs={hasDocs} />
  <section class="run" aria-labelledby="run-h" data-run data-input={first?.name} data-type={first?.type}>
    <div class="run-head">
      <p class="eyebrow" id="run-h">Run</p>
      <div class="rtabs" role="radiogroup" aria-label="Run from">
        <input type="radio" name="runfrom" id="rf-term" value="term" checked class="sr-only" />
        <label for="rf-term">Terminal</label>
        <input type="radio" name="runfrom" id="rf-agent" value="agent" class="sr-only" />
        <label for="rf-agent">Agent</label>
      </div>
    </div>
    <div class="rpane" data-pane="agent">
      <p class="note small">Through <code>ot mcp</code>, an agent calls <code>run_tool</code> with this; <code>ot</code> asks you before anything that goes online or touches a target. <a href="/docs/agents">Set it up</a>: <code>ot mcp install claude</code> (or cursor, vscode, codex, gemini).</p>
      <div class="cmd agent-cmd" role="group" aria-label="run_tool arguments">
        <code data-agent-call data-template={agentCall}>{agentCall}</code>
        <button class="btn copy" type="button" data-copy={agentCall} aria-label="Copy the run_tool arguments"><span class="label">Copy</span></button>
      </div>
      <p class="note small">Or just say: "Run {ref} on {first ? ex(first).replace(/^"|"$/g, "") : "…"} with OTInstaller." The registry's read-only MCP server at <code>api.otinstaller.com/mcp</code> can find tools without installing anything.</p>
    </div>
    <div class="rpane" data-pane="term">
    <div class="cmd" role="group" aria-label="Run command">
      <code data-run-cmd data-template={runCmd}>{runCmd}</code>
      <button class="btn copy" type="button" data-copy={runCmd} aria-label="Copy the run command"><span class="label">Copy</span></button>
    </div>
    <div class="cmd" role="group" aria-label="Install command">
      <code>ot install {ref}</code>
      <button class="btn copy" type="button" data-copy={`ot install ${ref}`} aria-label="Copy the install command"><span class="label">Copy</span></button>
    </div>
    <p class="note small">{runtimeLine}. The first <code>ot run</code> installs the tool after asking once.{fromTest && <> The example value is the registry's own test input, so this command has run.</>} Drop <code>--format table</code> for JSON.</p>
    <details class="noot">
      <summary class="small">Don't have <code>ot</code>? Install it in one line</summary>
      <InstallBlock name="tool" compact />
    </details>
    </div>
  </section>

  <div class="two-col">
    <div class="stack main">
      <Evidence lines={lines} securityHref={`/${ref}/security`} />

      {community && (
        <section class="panel community" aria-labelledby="com-h">
          <div class="ph"><h2 id="com-h">From the community</h2><a href={`/${ref}/issues`}>Issues →</a></div>
          <p class="line"><span class={`status ${STATE_TONE[community.line.state]}`}>{community.line.text}</span></p>
          <div class="pad"><WorksForMe client:visible refName={ref} version={t.latest_version} back={`${Astro.site}${ref}`} /></div>
        </section>
      )}

      <section class="panel sample-panel" aria-labelledby="out-h">
        <div class="ph"><h2 id="out-h">What you get back</h2><a href="/docs/results">Result envelope →</a></div>
        {recordedText ? (
          <pre class="sample"><code>{recordedText}</code></pre>
        ) : (
          <pre class="sample"><code>{sample}</code></pre>
        )}
        {recorded ? (
          <p class="small muted pad">Recorded from the registry's own run of version {t.sample!.version} on its test input, {recordedOn}. <code>--format table</code> to read it; <code>ot extract</code> and <code>ot auto</code> to continue.</p>
        ) : recordedText ? (
          <p class="small muted pad">The start of what version {t.sample!.version} printed on its test input ({t.sample!.output_format}), recorded by the registry on {recordedOn}. <code>ot run</code> wraps it in the <a href="/docs/results">result envelope</a>.</p>
        ) : (
          <p class="small muted pad">Every tool returns this shape, shaped here from what this tool declares it finds. <code>--format table</code> to read it; <code>ot extract</code> and <code>ot auto</code> to continue.</p>
        )}
      </section>

      <section class="prose readme" aria-label="README">
        {readme ? <Fragment set:html={demoteHeadings(readme.html)} /> : <p class="muted">This version has no rendered README yet.</p>}
      </section>

      {guides && guides.guides.length > 0 && (
        <section aria-labelledby="guides">
          <div class="section-head"><h2 id="guides">Guides using this tool</h2></div>
          <div class="rows">{guides.guides.map((g) => <ToolRow tool={g} />)}</div>
        </section>
      )}

      {leads.length > 0 && (
        <section aria-labelledby="next">
          <div class="section-head"><h2 id="next">What next</h2></div>
          <p class="small muted">{t.name} finds {pivotFrom.map(entityLabel).join(", ")}. Tools that take those:</p>
          <p class="row pivots">{leads.map((l) => <a class="chip" href={`/input/${l.type}`}>{entityLabel(l.type)} → {l.n} {l.n === 1 ? "tool" : "tools"}</a>)}<a class="chip" href="/docs/results">ot auto, with a saved result</a></p>
        </section>
      )}

      {required0 && alternatives.length > 0 && (
        <section aria-labelledby="alt">
          <div class="section-head"><h2 id="alt">Other {inputLabel(required0.type).toLowerCase()} tools</h2><a href={`/input/${required0.type}`}>All {inputLabel(required0.type).toLowerCase()} tools →</a></div>
          <p class="small muted">Alternatives to {t.name} that also take {article(inputLabel(required0.type))} {inputLabel(required0.type).toLowerCase()}; <code>ot auto</code> runs every installed one on the same value.</p>
          <div class="rows">{alternatives.map((s) => <ToolRow tool={s} />)}</div>
        </section>
      )}
    </div>

    <aside class="panel facts" aria-label="Facts">
      <section>
        <h3>Takes</h3>
        {(m.inputs ?? []).length === 0 ? <p class="small muted">No inputs.</p> : (
          <ul class="list-plain small">
            {(m.inputs ?? []).map((i) => (
              <li><code>--{i.name}</code> {inputLabel(i.type).toLowerCase()} <span class="faint">{i.required ? "required" : "optional"}</span>{i.description && <div class="muted desc">{i.description}</div>}</li>
            ))}
          </ul>
        )}
        <p class="small muted hint">Or as a typed value: <code>ot run {ref} {first ? `${{ email: "e", username: "u", domain: "d", phone: "p", ip: "ip", url: "url" }[first.type] ?? "u"}:…` : ""}</code></p>
      </section>
      <section>
        <h3>Finds</h3>
        <ul class="list-plain small finds">
          {pivotFrom.map((o) => {
            const n = pivots?.pivots[o]?.length ?? 0;
            return <li>{n > 0 ? <><a href={`/input/${o}`}>{entityLabel(o)}</a> <span class="faint">→ {n} {n === 1 ? "tool takes it" : "tools take it"}</span></> : entityLabel(o)}</li>;
          })}
        </ul>
      </section>
      <section>
        <h3>Keys</h3>
        {m.secrets && m.secrets.length > 0 ? (
          <ul class="list-plain small">
            {m.secrets.map((s) => (
              <li><code>{s.name}</code> <span class="faint">{s.required ? "required" : "optional"}</span>{s.url && <> · <a href={s.url} rel="nofollow noopener">get one</a></>}{s.description && <div class="muted desc">{s.description}</div>}<div class="keycmd"><code>ot keys set {s.name}</code><button class="btn btn-sm copy" type="button" data-copy={`ot keys set ${s.name}`} aria-label={`Copy: ot keys set ${s.name}`}><span class="label">Copy</span></button></div></li>
            ))}
            <li class="muted">The key goes into your OS keychain and is passed to this tool's container only; it never appears in a command line or a saved result.</li>
          </ul>
        ) : <p class="small muted">None needed.</p>}
      </section>
      {e && (
        <section>
          <h3>Behaviour</h3>
          <ul class="list-plain small beh">
            {ethicsLines(e, egress).map((l) => <li class:list={{ yes: l.yes }}>{l.text}<div class="muted desc">{l.why}</div></li>)}
          </ul>
          {egress && m.network?.domains?.length ? <p class="small muted hint">Talks to: {m.network.domains.join(", ")}</p> : null}
        </section>
      )}
      <section>
        <h3>Details</h3>
        <dl class="small">
          <dt>Licence</dt><dd>{t.license}</dd>
          <dt>Runtime</dt><dd>{m.runtime?.kind === "docker" ? "Docker image" : `Python wheel${m.runtime?.package ? ` (${m.runtime.package})` : ""}`}</dd>
          {t.repo_url && <><dt>Source</dt><dd><a href={t.repo_url} rel="nofollow noopener">{t.repo_url.replace(/^https:\/\//, "")}</a></dd></>}
          {t.homepage && t.homepage !== t.repo_url && <><dt>Upstream</dt><dd><a href={t.homepage} rel="nofollow noopener">{t.homepage.replace(/^https:\/\//, "")}</a></dd></>}
          <dt>Categories</dt><dd>{t.categories.map((c, i) => <>{i > 0 && ", "}<a href={`/category/${c}`}>{c}</a></>)}</dd>
          <dt>Published</dt><dd>{formatDate(latest?.published_at)}</dd>
          {t.installs_30d >= 10 && <><dt>Installs</dt><dd>{t.installs_30d} in 30 days</dd></>}
        </dl>
      </section>
      <section class="links small">
        <a href={jsonHref}>View as JSON</a> · <a href={`/${ref}.md`}>Markdown</a> · <a href={`https://api.otinstaller.com/v1/tools/${ref}/${t.latest_version}/manifest`}>Manifest</a> · <a href={`/${ref}/report`}>Report this tool</a>
      </section>
    </aside>
  </div>
  <CopyCode onlyOt />
</Base>

<script>
  // Fill the run command with the value pasted on the input page. The value stays in this browser.
  const value = new URLSearchParams(location.search).get("value");
  const run = document.querySelector<HTMLElement>("[data-run]");
  const code = document.querySelector<HTMLElement>("[data-run-cmd]");
  const input = run?.dataset.input;
  if (value && run && code && input) {
    const safe = /^[\w@.+:\/%-]+$/.test(value) ? value : `"${value.replace(/"/g, '\\"')}"`;
    const cmd = code.dataset.template!.replace(new RegExp(`--${input} \\S+`), `--${input} ${safe}`);
    code.textContent = cmd;
    const btn = run.querySelector<HTMLButtonElement>("[data-pane=term] button[data-copy]");
    if (btn) btn.dataset.copy = cmd;
    const agent = document.querySelector<HTMLElement>("[data-agent-call]");
    if (agent) {
      try {
        const call = JSON.parse(agent.dataset.template!) as Record<string, string>;
        call.target = value;
        const json = JSON.stringify(call);
        agent.textContent = json;
        const abtn = run.querySelector<HTMLButtonElement>("[data-pane=agent] button[data-copy]");
        if (abtn) abtn.dataset.copy = json;
      } catch {}
    }
  }
</script>

<style>
  .run { background: var(--code-bg); color: var(--code-text); border: 1px solid var(--border-strong); padding: 14px; display: grid; gap: 10px; }
  .run .eyebrow { margin: 0; color: var(--code-muted); }
  .run-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .rtabs { display: inline-flex; border: 1px solid var(--code-border); }
  .rtabs label { cursor: pointer; padding: 4px 10px; color: var(--code-muted); font-size: var(--fs-1); }
  .rtabs input:focus-visible + label { outline: 2px solid var(--code-text); outline-offset: -2px; }
  .rpane { display: none; }
  .rpane > * + * { margin-top: 10px; }
  .run:has(#rf-term:checked) [data-pane="term"], .run:has(#rf-agent:checked) [data-pane="agent"] { display: block; }
  .rtabs:has(#rf-term:checked) label[for="rf-term"], .rtabs:has(#rf-agent:checked) label[for="rf-agent"] { background: var(--code-text); color: var(--code-bg); }
  .agent-cmd::before { content: "{}"; }
  .agent-cmd code { white-space: pre-wrap; }
  .run .note { margin: 0; color: var(--code-muted); }
  .run .note code { color: var(--code-text); }
  /* The install block inside the dark run block reads the terminal palette in both themes. */
  .noot { --text: var(--code-text); --text-muted: var(--code-muted); --text-faint: var(--code-muted); --bg: var(--code-bg); --bg-inverse: var(--code-text); --border: var(--code-border); --border-strong: var(--code-muted); --bg-subtle: var(--code-raised); }
  .noot summary { cursor: pointer; color: var(--code-muted); }
  .noot summary:hover { color: var(--code-text); }
  .noot summary code { color: var(--code-text); }
  .noot[open] summary { margin-bottom: 10px; }
  .main > * + * { margin-top: 20px; }
  .sample-panel { padding: 0; }
  .ph { display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border-bottom: 1px solid var(--border); }
  .ph h2 { margin: 0; }
  .ph a { font-size: var(--fs-1); color: var(--text-muted); }
  .sample { margin: 0; padding: 12px 14px; font-size: var(--fs-1); line-height: 1.55; overflow-x: auto; color: var(--text-muted); }
  .pad { padding: 10px 14px; margin: 0; border-top: 1px solid var(--border); }
  .community { padding: 0; }
  .community .line { margin: 0; padding: 12px 14px; font-size: var(--fs-2); }
  .readme { padding-top: 4px; }
  .pivots { gap: 8px; }
  .pivots .chip { text-transform: none; letter-spacing: 0; font-size: var(--fs-1); height: 28px; }
  .facts { padding: 0; position: sticky; top: 76px; }
  .facts section { padding: 12px 14px; border-bottom: 1px solid var(--border); }
  .facts section:last-child { border-bottom: 0; }
  .facts h3 { margin: 0 0 8px; font-size: var(--fs-0); text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-faint); font-weight: 600; }
  .facts li + li { margin-top: 8px; }
  .facts .desc { margin-top: 2px; }
  .keycmd { display: flex; gap: 8px; align-items: center; margin-top: 6px; }
  .facts .hint { margin: 10px 0 0; overflow-wrap: anywhere; }
  .facts dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 6px 12px; }
  .facts dt { color: var(--text-muted); }
  .facts dd { margin: 0; word-break: break-word; }
  .finds a { text-decoration: none; }
  .finds a:hover { text-decoration: underline; }
  .beh li { display: flex; gap: 8px; }
  .beh li::before { content: "✓"; color: var(--ok); font-weight: 700; }
  .beh li.yes::before { content: "!"; color: var(--warn); }
  .facts p { margin: 0; }
  @media (max-width: 960px) {
    .two-col { display: flex; flex-direction: column; }
    .facts { order: -1; position: static; }
    .main { margin-top: 20px; }
    .main > :nth-child(1) { order: 0; }
  }
</style>
