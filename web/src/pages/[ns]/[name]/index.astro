---
import Base from "../../../layouts/Base.astro";
import ToolHeader from "../../../components/ToolHeader.astro";
import CopyCommand from "../../../components/CopyCommand.astro";
import CopyCode from "../../../components/CopyCode.astro";
import ToolCard from "../../../components/ToolCard.astro";
import { apiOrNull, type SearchResult, type Scans } from "../../../lib/api";
import { entityLabel, exampleRun, formatDate, inputLabel } from "../../../lib/format";
import { loadTool } from "../../../lib/tool";
import { cacheFor } from "../../../lib/page";

const loaded = await loadTool(Astro);
if ("response" in loaded) return loaded.response;
const { tool: t, hasDocs } = loaded;
const ref = `${t.namespace}/${t.name}`;
const m = t.manifest;
const [readme, guides, scans, latest] = await Promise.all([
  apiOrNull<{ html: string }>(`/tools/${ref}/readme`),
  apiOrNull<{ guides: SearchResult["results"] }>(`/tools/${ref}/guides`),
  apiOrNull<Scans>(`/tools/${ref}/${t.latest_version}/scans`),
  apiOrNull<{ published_at: number | null }>(`/tools/${ref}/${t.latest_version}`),
]);
const e = m.ethics;
cacheFor(Astro, 60);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: ref,
  description: t.summary,
  softwareVersion: t.latest_version,
  applicationCategory: "SecurityApplication",
  operatingSystem: "Windows, macOS, Linux",
  license: t.license,
  url: `${Astro.site}${ref}`,
  ...(t.repo_url ? { codeRepository: t.repo_url } : {}),
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
const yes = (v: boolean) => (v ? "yes" : "no");
---
<Base title={ref} description={t.summary} jsonLd={jsonLd}>
  <ToolHeader tool={t} active="overview" hasDocs={hasDocs} scanStatus={scans?.scan_status} />
  <div class="two-col">
    <div class="stack">
      <section class="run-box fade-in" aria-labelledby="install">
        <h2 id="install" class="eyebrow">Install and run</h2>
        <CopyCommand label="Install" command={`ot install ${ref}`} />
        <CopyCommand label="Run" command={exampleRun(ref, m.inputs)} />
        <p class="small muted">The first <code>ot run</code> installs the tool after asking once. New to <code>ot</code>? <a href="/docs/getting-started">Install the CLI</a>.</p>
      </section>
      <section class="prose readme" aria-label="README">
        {readme ? <Fragment set:html={readme.html} /> : <p class="muted">This version has no rendered README yet.</p>}
      </section>
      {guides && guides.guides.length > 0 && (
        <section aria-labelledby="guides">
          <h2 id="guides">Guides using this tool</h2>
          <div class="grid stagger">{guides.guides.map((g) => <ToolCard tool={g} />)}</div>
        </section>
      )}
    </div>
    <aside class="stack side">
      <section class="panel" aria-labelledby="io">
        <h2 id="io">Inputs and outputs</h2>
        <ul class="list-plain small io">
          {(m.inputs ?? []).map((i) => (
            <li><code>--{i.name}</code> <span class="type">{inputLabel(i.type)}</span>{!i.required && <span class="faint"> optional</span>}{i.description && <div class="muted">{i.description}</div>}</li>
          ))}
        </ul>
        <p class="small finds"><strong>Finds</strong> {(m.outputs ?? []).map((o) => <span class="badge plain">{entityLabel(o.type)}</span>)}</p>
      </section>
      {m.secrets && m.secrets.length > 0 && (
        <section class="panel" aria-labelledby="keys">
          <h2 id="keys">API keys</h2>
          <ul class="list-plain small">
            {m.secrets.map((s) => (
              <li><code>{s.name}</code> <span class="faint">{s.required ? "required" : "optional"}</span>{s.url && <> · <a href={s.url} rel="nofollow noopener">get one</a></>}{s.description && <div class="muted">{s.description}</div>}</li>
            ))}
          </ul>
          <p class="small muted">Store keys with <code>ot keys set NAME</code>; they stay in your OS keychain.</p>
        </section>
      )}
      {e && (
        <section class="panel" aria-labelledby="ethics">
          <h2 id="ethics">What it does</h2>
          <ul class="list-plain small ethics">
            <li data-v={yes(e.touches_target)}>{e.touches_target ? "Contacts the target directly" : "Does not contact the target"}</li>
            <li data-v={yes(e.auth_required)}>{e.auth_required ? "Logs in to accounts" : "Does not log in to accounts"}</li>
            <li data-v={yes(e.collects_personal_data)}>{e.collects_personal_data ? "Collects personal data" : "Does not collect personal data"}</li>
          </ul>
          {m.network?.domains && m.network.domains.length > 0 && <p class="small muted">Talks to: {m.network.domains.join(", ")}</p>}
        </section>
      )}
      <section class="panel" aria-labelledby="facts">
        <h2 id="facts">Details</h2>
        <dl>
          <dt>License</dt><dd>{t.license}</dd>
          <dt>Runtime</dt><dd>{t.runtime === "docker" ? "Docker" : "pipx"}</dd>
          {t.repo_url && <><dt>Source</dt><dd><a href={t.repo_url} rel="nofollow noopener">{t.repo_url.replace(/^https:\/\//, "")}</a></dd></>}
          {t.homepage && t.homepage !== t.repo_url && <><dt>Homepage</dt><dd><a href={t.homepage} rel="nofollow noopener">{t.homepage.replace(/^https:\/\//, "")}</a></dd></>}
          <dt>Categories</dt><dd>{t.categories.map((c, i) => <>{i > 0 && ", "}<a href={`/category/${c}`}>{c}</a></>)}</dd>
          <dt>Published</dt><dd>{formatDate(latest?.published_at)}</dd>
        </dl>
      </section>
      <p class="small side-links"><a href={`/${ref}/security`}>Security details</a> · <a href={`/${ref}/report`}>Report this tool</a></p>
    </aside>
  </div>
  <CopyCode onlyOt />
</Base>

<style>
  .run-box { display: grid; gap: 10px; padding: 18px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-raised); box-shadow: var(--shadow-1); }
  .run-box h2 { margin: 0; }
  .run-box p { margin: 2px 0 0; }
  .readme { padding-top: 8px; }
  .side { position: sticky; top: 84px; }
  @media (max-width: 960px) { .side { position: static; } }
  .io li + li { margin-top: 10px; }
  .type { color: var(--text-muted); }
  .finds { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 12px 0 0; }
  .ethics li { padding-left: 24px; position: relative; }
  .ethics li::before { content: "✓"; position: absolute; left: 0; font-weight: 700; color: var(--ok); }
  .ethics li[data-v="yes"]::before { content: "!"; color: var(--warn); }
  .side-links { margin: 0; }
</style>
