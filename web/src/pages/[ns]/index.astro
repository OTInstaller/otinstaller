---
import Base from "../../layouts/Base.astro";
import ToolCard from "../../components/ToolCard.astro";
import { apiOrNull, type Namespace } from "../../lib/api";
import { formatDate } from "../../lib/format";
import { cacheFor } from "../../lib/page";

const ns = Astro.params.ns!;
const n = await apiOrNull<Namespace>(`/namespaces/${encodeURIComponent(ns)}`);
if (!n) return Astro.rewrite("/404");
const tools = n.tools.filter((t) => t.kind === "tool");
const guides = n.tools.filter((t) => t.kind === "guide");
const profile = n.provider === "github" ? `https://github.com/${n.name}` : n.provider === "gitlab" ? `https://gitlab.com/${n.name}` : null;
const name = n.display_name ?? n.name;
cacheFor(Astro, 300);
---
<Base title={name} description={`OSINT tools and guides published by ${name}.`}>
  <header class="pub fade-in">
    <span class:list={["avatar", { verified: n.verified }]}>
      {n.avatar_url ? <img src={n.avatar_url} alt="" width="72" height="72" /> : <span class="initial" aria-hidden="true">{n.name.slice(0, 1).toUpperCase()}</span>}
    </span>
    <div>
      <p class="eyebrow">Publisher</p>
      <h1>{name}</h1>
      <div class="badges">
        {n.verified && <span class="badge ok">Verified publisher</span>}
        <span class="badge">{n.kind === "user" ? "User" : n.kind === "group" ? "Group" : "Organization"} on {n.provider === "gitlab" ? "GitLab" : "GitHub"}</span>
        <span class="badge plain">{tools.length} {tools.length === 1 ? "tool" : "tools"}{guides.length > 0 && <>, {guides.length} {guides.length === 1 ? "guide" : "guides"}</>}</span>
      </div>
      <p class="small muted">Publishing since {formatDate(n.created_at)}{profile && <> · <a href={profile} rel="nofollow noopener">{profile.replace("https://", "")}</a></>}</p>
    </div>
  </header>
  <section aria-labelledby="tools">
    <h2 id="tools">Tools</h2>
    {tools.length ? <div class="grid stagger">{tools.map((t) => <ToolCard tool={t} />)}</div> : <p class="muted">No tools yet.</p>}
  </section>
  {guides.length > 0 && (
    <section aria-labelledby="guides">
      <h2 id="guides">Guides</h2>
      <div class="grid stagger">{guides.map((t) => <ToolCard tool={t} />)}</div>
    </section>
  )}
</Base>

<style>
  .pub { display: flex; gap: 20px; align-items: center; padding-bottom: 24px; border-bottom: 1px solid var(--border); margin-bottom: 8px; }
  .pub h1 { margin: 0 0 8px; }
  .pub .eyebrow { margin: 0; }
  .avatar { display: grid; place-items: center; flex: none; width: 76px; height: 76px; border-radius: 50%; padding: 2px; background: var(--border); }
  .avatar.verified { background: linear-gradient(135deg, var(--ok), var(--accent)); box-shadow: 0 0 24px -6px rgb(var(--ok-rgb) / 60%); }
  .avatar img, .initial { width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center; background: var(--bg-raised); object-fit: cover; }
  .initial { font-family: var(--font-mono); font-weight: 700; font-size: 1.6rem; color: var(--accent); }
  .badges { margin-bottom: 6px; }
</style>
