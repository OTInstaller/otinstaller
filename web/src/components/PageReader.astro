---
// A rendered page with its navigation and table of contents: the guide reader and the tool docs tab.
import type { NavEntry, Page } from "../lib/api";

interface Props {
  page: Page;
  nav: NavEntry[];
  /** The site address of a page in this navigation. */
  hrefFor: (path: string) => string;
  label: string;
}
const { page, nav, hrefFor, label } = Astro.props;
const toc = page.toc.filter((t) => t.depth >= 2);
---
<div class="three-col reader">
  <nav class="side" aria-label={label}>
    <ol class="list-plain small">
      {nav.map((n, i) => (
        <li><a href={hrefFor(n.path)} aria-current={n.path === page.path ? "page" : undefined}><span class="num">{i + 1}.</span> {n.title}</a></li>
      ))}
    </ol>
  </nav>
  <article>
    <div class="prose" set:html={page.body} />
    <nav class="pager row" aria-label="Pages">
      {page.prev ? <a class="btn" href={hrefFor(page.prev.path)} rel="prev">← {page.prev.title}</a> : <span />}
      {page.next && <a class="btn" href={hrefFor(page.next.path)} rel="next">{page.next.title} →</a>}
    </nav>
  </article>
  <aside class="toc small" aria-label="On this page">
    {toc.length > 0 && (
      <>
        <p class="muted"><strong>On this page</strong></p>
        <ul class="list-plain">{toc.map((t) => <li class={`d${t.depth}`}><a href={`#${t.id}`}>{t.text}</a></li>)}</ul>
      </>
    )}
  </aside>
</div>

<script>
  // A copy button on every code block that runs ot, as on tool pages.
  for (const code of document.querySelectorAll<HTMLElement>(".reader pre > code")) {
    const text = code.textContent ?? "";
    if (!/^\s*(\$\s*)?ot\s/m.test(text)) continue;
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "btn copy-code";
    btn.textContent = "Copy";
    btn.dataset.copy = text.replace(/^\s*\$\s*/gm, "").trim();
    code.parentElement!.prepend(btn);
  }
  document.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button.copy-code");
    if (!btn) return;
    await navigator.clipboard.writeText(btn.dataset.copy ?? "").catch(() => {});
    btn.textContent = "Copied";
    setTimeout(() => (btn.textContent = "Copy"), 1500);
  });
</script>

<style>
  .side { position: sticky; top: 12px; }
  .side a { display: block; padding: 4px 8px; border-radius: var(--radius-sm); text-decoration: none; color: var(--text); }
  .side a[aria-current="page"] { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .num { color: var(--text-muted); }
  .toc { position: sticky; top: 12px; }
  .toc .d3 { padding-left: 12px; }
  .pager { justify-content: space-between; margin-top: 32px; border-top: 1px solid var(--border); padding-top: 16px; }
  :global(.reader pre) { position: relative; }
  :global(.copy-code) { position: absolute; top: 6px; right: 6px; font-size: 0.78rem; padding: 3px 8px; }
</style>
