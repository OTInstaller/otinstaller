---
// A number that counts up when it scrolls into view. The rendered text is already the final value.
import { formatCount } from "../lib/format";

interface Props {
  value: number;
  label: string;
  suffix?: string;
}
const { value, label, suffix = "" } = Astro.props;
---
<div class="stat reveal">
  <span class="value"><span data-count={value}>{formatCount(value)}</span>{suffix}</span>
  <span class="label small muted">{label}</span>
</div>

<style>
  .stat { display: grid; gap: 2px; }
  .value { font-size: var(--fs-5); font-weight: 760; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; line-height: 1.1; color: var(--text); }
  .label { letter-spacing: 0.01em; }
</style>
