---
// A card for a tool or guide, a cell in a bordered grid. Lists use ToolRow; cards remain for the guide index.
import type { ToolSummary } from "../lib/api";
import { inputLabel } from "../lib/format";

interface Props {
  tool: ToolSummary;
  /** Heading level for the card title: 2 where cards sit right under the page title. */
  level?: 2 | 3;
}
const { tool: t, level = 3 } = Astro.props;
const Heading = level === 2 ? "h2" : "h3";
const ref = `${t.namespace}/${t.name}`;
const guide = t.kind === "guide";
const href = guide ? `/guides/${ref}` : `/${ref}`;
const health = t.health === "healthy" ? { cls: "ok", text: "Health check passing" } : t.health === "broken" ? { cls: "warn", text: "Possibly broken" } : null;
---
<article class="card tool-card">
  <Heading class="card-title"><a href={href}>{guide ? t.title ?? ref : <><span class="ns">{t.namespace}/</span>{t.name}</>}</a></Heading>
  <p class="small faint ref">{guide ? `${ref} · ${t.level ?? "guide"}` : `v${t.latest_version}`}</p>
  <p class="summary small muted">{t.summary}</p>
  <p class="small meta">
    {t.inputs.length > 0 && <span class="muted">{guide ? "About" : "Takes"} {t.inputs.slice(0, 3).map(inputLabel).join(", ").toLowerCase()}{t.inputs.length > 3 ? "…" : ""}</span>}
    {health && <span class={`status ${health.cls}`}>{health.text}</span>}
    {t.status === "deprecated" && <span class="status warn">Deprecated</span>}
    {guide && t.needs_update && <span class="status warn">Needs update</span>}
  </p>
</article>

<style>
  .tool-card { display: grid; gap: 4px; align-content: start; }
  .card-title a { text-decoration: none; }
  .card-title a:hover { text-decoration: underline; }
  .ns { color: var(--text-faint); font-weight: 400; }
  .ref, .summary { margin: 0; }
  .meta { margin: 6px 0 0; display: flex; gap: 6px 14px; flex-wrap: wrap; }
</style>
