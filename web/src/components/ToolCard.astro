---
import type { ToolSummary } from "../lib/api";
import { formatCount, inputLabel } from "../lib/format";
import Badges from "./Badges.astro";

interface Props {
  tool: ToolSummary;
  /** Heading level for the card title: 2 where cards sit right under the page title. */
  level?: 2 | 3;
}
const { tool: t, level = 3 } = Astro.props;
const Heading = level === 2 ? "h2" : "h3";
const ref = `${t.namespace}/${t.name}`;
const guide = t.kind === "guide";
const href = guide ? `/guides/${ref}` : `/${ref}`;
// A stable hue per namespace for the avatar tile.
const hue = [...t.namespace].reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 360, 7);
const hueClass = `h${Math.floor(hue / 45)}`;
---
<article class:list={["card tool-card reveal", { guide }]}>
  <div class="top">
    <span class:list={["avatar", hueClass]} aria-hidden="true">{guide ? "§" : t.name.slice(0, 1).toUpperCase()}</span>
    <div class="titles">
      <Heading class="card-title"><a href={href}>{guide ? t.title ?? ref : <><span class="ns">{t.namespace}/</span>{t.name}</>}</a></Heading>
      <p class="small faint ref">{guide ? ref : `v${t.latest_version}`}</p>
    </div>
  </div>
  <p class="summary">{t.summary}</p>
  <Badges tool={t} />
  <p class="small muted meta">
    {t.inputs.length > 0 && <span>{guide ? "About" : "Takes"} {t.inputs.slice(0, 3).map(inputLabel).join(", ")}{t.inputs.length > 3 ? "…" : ""}</span>}
    {!guide && <span title="Installs in the last 30 days"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>{formatCount(t.installs_30d)}</span>}
    <span title="Stars"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3 6.6 7 .8-5.2 4.8 1.4 7L12 17.7 5.8 21.2l1.4-7L2 9.4l7-.8z" /></svg>{formatCount(t.stars)}</span>
  </p>
</article>

<style>
  .tool-card { display: flex; flex-direction: column; gap: 10px; }
  .top { display: flex; gap: 12px; align-items: center; }
  .avatar { display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 11px; font-family: var(--font-mono); font-weight: 700; font-size: 1rem; color: #fff; background: linear-gradient(135deg, hsl(var(--h) 70% 48%), hsl(calc(var(--h) + 40) 70% 38%)); box-shadow: inset 0 1px 0 rgb(255 255 255 / 25%); }
  .h0 { --h: 210; } .h1 { --h: 255; } .h2 { --h: 300; } .h3 { --h: 345; } .h4 { --h: 20; } .h5 { --h: 160; } .h6 { --h: 190; } .h7 { --h: 230; }
  .guide .avatar { background: linear-gradient(135deg, var(--ok), #0e7490); }
  .titles { min-width: 0; }
  .card-title { font-family: var(--font-mono); font-size: 0.98rem; font-weight: 650; letter-spacing: -0.01em; }
  .guide .card-title { font-family: var(--font-sans); font-size: 1.05rem; }
  .card-title a { color: var(--text); text-decoration: none; }
  .card-title a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .card-title a:hover { color: var(--accent); }
  .ns { color: var(--text-faint); font-weight: 500; }
  .ref { margin: 0; font-family: var(--font-mono); }
  .summary { margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: var(--text-muted); font-size: var(--fs-1); min-height: 2.9em; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: auto 0 0; align-items: center; }
  .meta span { display: inline-flex; align-items: center; gap: 4px; }
  .meta svg { width: 13px; height: 13px; opacity: 0.75; }
  .tool-card :global(.badges) { position: relative; z-index: 1; pointer-events: none; }
</style>
