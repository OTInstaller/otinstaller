---
// One tool request in a list: its votes (with a vote button while it takes votes), the repository and what it does,
// who asked and when, and its status.
import type { ToolRequest } from "../lib/api";
import { formatDate } from "../lib/format";
import { REQUEST_STATUS_LABEL, REQUEST_STATUS_TONE, requestHref, takesVotes } from "../lib/requests";
import { personHref } from "../lib/community";
import RequestVote from "../islands/RequestVote";

interface Props {
  request: ToolRequest;
}
const { request: r } = Astro.props;
---
<li class="rrow">
  <div class="votes">
    {takesVotes(r.status)
      ? <RequestVote client:visible number={r.number} votes={r.votes} />
      : <span class="count" aria-label={`${r.votes} votes`}>{r.votes}</span>}
  </div>
  <div class="main">
    <p class="title"><a href={requestHref(r.number)}>{r.repo}</a> <span class="small muted">#{r.number}</span></p>
    {r.description && <p class="small desc">{r.description}</p>}
    <p class="small muted meta">
      {r.provider === "gitlab" ? "GitLab" : "GitHub"}{r.license && <> · {r.license}</>}{r.upstream_stars !== null && <> · {r.upstream_stars.toLocaleString("en")} stars</>}
      {" "}· asked by {r.requested_by ? (r.requested_by.profile ? <a href={personHref(r.requested_by.handle)}>{r.requested_by.handle}</a> : r.requested_by.handle) : "a deleted account"} on {formatDate(r.created_at)}
      {r.tool && <> · <a href={`/${r.tool}`}>{r.tool}</a></>}
    </p>
  </div>
  <div class="tags">
    <span class={`badge ${REQUEST_STATUS_TONE[r.status]}`}>{REQUEST_STATUS_LABEL[r.status]}</span>
    {r.otlite && <span class="badge plain" title="otlite, the no-Docker edition, installs it already">In otlite</span>}
  </div>
</li>

<style>
  .rrow { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; gap: 8px 16px; align-items: start; padding: 12px 0; border-bottom: 1px solid var(--border); }
  .votes { display: flex; justify-content: center; }
  .count { font-variant-numeric: tabular-nums; font-weight: 600; padding-top: 4px; }
  .title { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
  .desc { margin: 2px 0 0; overflow-wrap: anywhere; }
  .meta { margin: 2px 0 0; overflow-wrap: anywhere; }
  .tags { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  @media (max-width: 640px) {
    .rrow { grid-template-columns: 56px minmax(0, 1fr); }
    .tags { grid-column: 2; justify-content: flex-start; }
  }
</style>
