---
// Cycles dark → light → system. Dark is the site's default (as on osintverse.com); the choice is saved in
// localStorage and applied before paint by the boot script.
---
<button class="theme-toggle" type="button" data-theme-toggle aria-label="Theme: dark. Switch to light" title="Switch theme">
  <svg class="ic ic-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
  <svg class="ic ic-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
  <svg class="ic ic-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" /><path d="M8 20h8M12 16v4" /></svg>
</button>

<script>
  const order = ["dark", "light", "system"] as const;
  type Theme = (typeof order)[number];
  const labels: Record<Theme, string> = { dark: "dark", light: "light", system: "follows your system" };
  const read = (): Theme => {
    try {
      const t = localStorage.getItem("theme");
      return t === "light" || t === "system" ? t : "dark";
    } catch {
      return "dark";
    }
  };
  const apply = (t: Theme) => {
    const html = document.documentElement;
    if (t === "dark") delete html.dataset.theme;
    else html.dataset.theme = t;
    try {
      if (t === "dark") localStorage.removeItem("theme");
      else localStorage.setItem("theme", t);
    } catch {}
    const next = order[(order.indexOf(t) + 1) % order.length]!;
    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
      b.setAttribute("aria-label", `Theme: ${labels[t]}. Switch to ${labels[next]}`);
      b.dataset.mode = t;
    }
  };
  apply(read());
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-theme-toggle]");
    if (!btn) return;
    const t = read();
    apply(order[(order.indexOf(t) + 1) % order.length]!);
  });
</script>

<style>
  .theme-toggle { display: inline-grid; place-items: center; width: 36px; height: 36px; border: 1px solid transparent; background: transparent; color: var(--text-muted); transition: color var(--dur-1), border-color var(--dur-1); }
  .theme-toggle:hover { color: var(--text); border-color: var(--border-strong); }
  .ic { grid-area: 1 / 1; width: 18px; height: 18px; display: none; }
  .theme-toggle:not([data-mode]) .ic-dark, .theme-toggle[data-mode="dark"] .ic-dark,
  .theme-toggle[data-mode="light"] .ic-light,
  .theme-toggle[data-mode="system"] .ic-system { display: block; }
</style>
