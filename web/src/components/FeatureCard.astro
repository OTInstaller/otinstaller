---
// A feature card with an icon slot.
interface Props {
  title: string;
  href?: string;
}
const { title, href } = Astro.props;
---
<article class="card feature reveal">
  <span class="icon" aria-hidden="true"><slot name="icon" /></span>
  <h3>{href ? <a href={href}>{title}</a> : title}</h3>
  <p class="small muted"><slot /></p>
</article>

<style>
  .feature { display: grid; gap: 10px; align-content: start; }
  .icon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--accent-soft); color: var(--accent); transition: rotate var(--dur-3) var(--ease-spring), scale var(--dur-3) var(--ease-spring); }
  .icon :global(svg) { width: 22px; height: 22px; }
  .feature:hover .icon { rotate: -6deg; scale: 1.06; }
  .feature h3 { margin: 0; font-size: var(--fs-3); }
  .feature h3 a { color: inherit; text-decoration: none; }
  .feature h3 a::after { content: ""; position: absolute; inset: 0; }
  .feature p { margin: 0; }
</style>
