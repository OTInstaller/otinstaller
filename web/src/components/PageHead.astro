---
// The title block at the top of list pages (search, input types, categories, dashboard…).
interface Props {
  eyebrow?: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---
<header class="page-head fade-in">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  <slot />
</header>

<style>
  .page-head { margin-bottom: 22px; }
  .page-head .eyebrow { margin: 0; }
  .page-head h1 { margin: 4px 0 6px; }
  .page-head :global(p:not(.eyebrow)) { margin: 0; max-width: 64ch; }
</style>
