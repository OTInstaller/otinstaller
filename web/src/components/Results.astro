---
// A search result list with a facet rail, used by /search, /input/{type} and /category/{slug}. Filter and sort
// links are nofollow (and filtered pages noindex, see Base.astro): crawlers walking every combination used up the
// registry database's daily reads. A `?value=` on the page is carried to each tool link by a small script, so the
// tool page can fill its run command; the value never reaches the API.
import ToolRow from "./ToolRow.astro";
import PasteBox from "./PasteBox.astro";
import type { SearchResult, Types } from "../lib/api";
import { categoryLabel, entityLabel, inputLabel } from "../lib/format";
import { withParam } from "../lib/page";

interface Props {
  result: SearchResult;
  types: Types;
  /** Facets fixed by the page (e.g. input on /input/email) are not offered. */
  fixed?: string[];
}
const { result, types, fixed = [] } = Astro.props;
const url = Astro.url;
const current = (k: string) => url.searchParams.get(k);
const facets = [
  { key: "input", label: "Takes", values: types.inputs, name: inputLabel },
  { key: "output", label: "Finds", values: types.outputs, name: entityLabel },
  { key: "category", label: "Category", values: types.categories, name: categoryLabel },
  { key: "runtime", label: "Runtime", values: ["docker", "pipx"], name: (v: string) => (v === "docker" ? "Docker" : "Python wheel") },
].filter((f) => !fixed.includes(f.key));
const sorts = [["relevance", "Best match"], ["updated", "Recently updated"], ["installs", "Most installed"], ["stars", "Most starred"]];
const next = result.next_cursor ? `${url.pathname}?${new URLSearchParams({ ...Object.fromEntries(url.searchParams), cursor: result.next_cursor })}` : null;
const activeFilters = facets.filter((f) => current(f.key)).map((f) => ({ key: f.key, label: f.name(current(f.key)!) }));
if (current("no_keys")) activeFilters.push({ key: "no_keys", label: "No key needed" });
const clearAll = `${url.pathname}${current("q") ? `?q=${encodeURIComponent(current("q")!)}` : ""}`;
---
<div class="results">
  <details class="facets-drawer" open>
    <summary class="btn btn-sm facets-toggle">Filters{activeFilters.length > 0 && <span class="n">{activeFilters.length}</span>}</summary>
    <aside class="facets" aria-label="Filters">
      <div class="facet">
        <p class="fl">Key</p>
        <ul class="list-plain">
          <li><a href={withParam(url, "no_keys", null)} rel="nofollow" aria-current={!current("no_keys") ? "page" : undefined}>Any</a></li>
          <li><a href={withParam(url, "no_keys", "1")} rel="nofollow" aria-current={current("no_keys") ? "page" : undefined}>No key needed</a></li>
        </ul>
      </div>
      {facets.map((f) => (
        <details class="facet" open={!!current(f.key) || f.key === "input"}>
          <summary class="fl">{f.label}{current(f.key) && <span class="n">1</span>}</summary>
          <ul class="list-plain">
            {f.values.map((v) => (
              <li><a href={withParam(url, f.key, current(f.key) === v ? null : v)} rel="nofollow" aria-current={current(f.key) === v ? "page" : undefined}>{f.name(v)}</a></li>
            ))}
          </ul>
        </details>
      ))}
    </aside>
  </details>
  <div class="list">
    <div class="toolbar">
      <div class="segmented" aria-label="Sort">
        {sorts.map(([k, label]) => <a href={withParam(url, "sort", k)} rel="nofollow" aria-current={(current("sort") ?? "relevance") === k ? "page" : undefined}>{label}</a>)}
      </div>
      {activeFilters.length > 0 && (
        <div class="row active small">
          {activeFilters.map((f) => <a class="chip" href={withParam(url, f.key, null)} rel="nofollow" aria-label={`Remove filter ${f.label}`}>{f.label} ✕</a>)}
          <a class="btn btn-ghost btn-sm" href={clearAll} rel="nofollow">Clear all</a>
        </div>
      )}
    </div>
    {result.results.length === 0
      ? (
        <div class="empty">
          <h2>Nothing is named that</h2>
          <p class="muted">Paste the value you have instead, and the registry finds the tools that take it. Or try fewer filters.</p>
          <PasteBox id="empty-q" />
        </div>
      )
      : <div class="rows">{result.results.map((t) => <ToolRow tool={t} level={2} />)}</div>}
    {next && <p class="more"><a class="btn" href={next} rel="next nofollow">More results</a></p>}
  </div>
</div>

<script>
  // Carry a pasted value from /input/{type}?value=… to each tool page, which fills its run command with it.
  const value = new URLSearchParams(location.search).get("value");
  if (value) {
    for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-tool-link]")) {
      const u = new URL(a.href);
      u.searchParams.set("value", value);
      a.href = u.toString();
    }
  }
</script>

<style>
  .results { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 32px; align-items: start; }
  .facets-drawer { position: sticky; top: 76px; }
  .facets-toggle { display: none; list-style: none; }
  .facets-toggle::-webkit-details-marker { display: none; }
  .n { display: inline-grid; place-items: center; min-width: 18px; height: 18px; padding: 0 5px; margin-left: 6px; background: var(--bg-inverse); color: var(--bg); font-size: var(--fs-0); }
  .facets { display: grid; }
  .facet { border-top: 1px solid var(--border); padding: 8px 0; }
  .fl { margin: 0; cursor: pointer; font-size: var(--fs-0); text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-faint); padding: 6px 0; display: flex; align-items: center; list-style: none; }
  .fl::-webkit-details-marker { display: none; }
  details > .fl::after { content: "+"; margin-left: auto; color: var(--text-faint); }
  details[open] > .fl::after { content: "−"; }
  .facet ul { margin: 2px 0 4px; max-height: 280px; overflow-y: auto; font-size: var(--fs-1); scrollbar-width: thin; }
  .facet li + li { margin-top: 0; }
  .facet a { display: flex; justify-content: space-between; padding: 5px 6px; text-decoration: none; color: var(--text-muted); }
  .facet a:hover { color: var(--text); background: var(--bg-subtle); }
  .facet a[aria-current="page"] { color: var(--text); background: var(--accent-soft); }
  .toolbar { display: grid; gap: 10px; margin-bottom: 12px; }
  .empty { padding: 32px 0; display: grid; gap: 10px; border-top: 1px solid var(--border); }
  .empty h2 { margin: 0; font-size: var(--fs-4); }
  .empty p { margin: 0; }
  .more { margin-top: 20px; text-align: center; }
  @media (max-width: 860px) {
    .results { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .facets-drawer { position: static; }
    .facets-drawer:not([open]) .facets { display: none; }
    .facets-toggle { display: inline-flex; width: max-content; }
    .facets { padding: 0 12px; border: 1px solid var(--border); margin-top: 8px; }
  }
</style>

<script>
  // The filter drawer starts closed on narrow screens (it is open in the HTML so it works without JavaScript on wide ones).
  const d = document.querySelector<HTMLDetailsElement>(".facets-drawer");
  if (d && matchMedia("(max-width: 860px)").matches) d.open = false;
</script>
