---
// The OTInstaller mark: a magnifier with a terminal prompt in the lens.
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true">
  <circle cx="10.5" cy="10.5" r="6.75" stroke="currentColor" stroke-width="2.2" />
  <path d="M15.6 15.6 21 21" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
  <path d="M8.2 8.3l2.3 2.2-2.3 2.2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
</svg>
