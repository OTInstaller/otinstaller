---
// The sticky side navigation shared by docs and policy pages, with an optional "On this page" list.
interface Props {
  label: string;
  pages: [href: string, label: string][];
  current: string;
  headings?: { depth: number; slug: string; text: string }[];
}
const { label, pages, current, headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<nav aria-label={label} class="side-nav small">
  <p class="eyebrow">{label}</p>
  <ul class="list-plain">
    {pages.map(([href, text]) => <li><a href={href} aria-current={current === href ? "page" : undefined}>{text}</a></li>)}
  </ul>
  {toc.length > 0 && (
    <div class="toc-block">
      <p class="eyebrow">On this page</p>
      <ul class="list-plain toc" data-toc>
        {toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
      </ul>
    </div>
  )}
</nav>

<script>
  // Highlight the heading that is on screen.
  const toc = document.querySelector<HTMLElement>("[data-toc]");
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>("a")];
    const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (!en.isIntersecting) continue;
          for (const a of links) a.removeAttribute("aria-current");
          byId.get(en.target.id)?.setAttribute("aria-current", "location");
        }
      },
      { rootMargin: "-80px 0px -70% 0px" },
    );
    for (const id of byId.keys()) {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    }
  }
</script>

<style>
  .side-nav { position: sticky; top: 76px; max-height: calc(100vh - 100px); overflow-y: auto; scrollbar-width: thin; }
  .side-nav .eyebrow { margin: 0 0 8px; font-size: 0.7rem; }
  .side-nav li + li { margin-top: 2px; }
  .side-nav a { display: block; padding: 6px 10px; border-radius: var(--radius-sm); text-decoration: none; color: var(--text-muted); border-left: 2px solid transparent; transition: color var(--dur-1), background var(--dur-1), border-color var(--dur-1); }
  .side-nav a:hover { color: var(--text); background: var(--bg-subtle); }
  .side-nav a[aria-current="page"] { background: var(--accent-soft); color: var(--text); font-weight: 600; }
  .toc-block { margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--border); }
  .toc a { padding: 4px 10px; border-radius: 0; font-size: 0.86rem; }
  .toc a[aria-current="location"] { color: var(--text); border-left-color: var(--text); background: transparent; }
  .toc .d3 { padding-left: 12px; }
  @media (max-width: 860px) { .side-nav { position: static; max-height: none; } .toc-block { display: none; } }
</style>
