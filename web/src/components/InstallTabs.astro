---
// Install commands per platform. Radio buttons drive the tabs (no JavaScript needed); a small script picks
// the visitor's platform. The command text is the source of truth in docs/getting-started.md as well.
import CopyCommand from "./CopyCommand.astro";

export const INSTALLS = [
  { id: "unix", label: "macOS / Linux", command: "curl -fsSL https://get.otinstaller.com/ot | sh", note: "Checks the SHA-256 and the release signature, then installs to /usr/local/bin or ~/.local/bin." },
  { id: "windows", label: "Windows", command: "irm https://get.otinstaller.com/ot.ps1 | iex", note: "Installs to %LOCALAPPDATA%\\Programs\\ot and adds it to your PATH." },
  { id: "brew", label: "Homebrew", command: "brew install --cask otinstaller/tap/ot", note: "From the otinstaller/homebrew-tap cask." },
  { id: "scoop", label: "Scoop", command: "scoop bucket add otinstaller https://github.com/otinstaller/scoop-bucket && scoop install ot", note: "From the otinstaller/scoop-bucket bucket." },
  { id: "go", label: "Go", command: "go install github.com/otinstaller/otinstaller/cli/cmd/ot@latest", note: "Builds from source with Go 1.25 or newer." },
];

interface Props {
  /** Prefix for the radio group, so two blocks on one page do not collide. */
  name?: string;
  compact?: boolean;
}
const { name = "os", compact = false } = Astro.props;
---
<div class:list={["install", { compact }]} data-install>
  <div class="tabs segmented" role="tablist" aria-label="Operating system">
    {INSTALLS.map((i, idx) => (
      <>
        <input type="radio" name={name} id={`${name}-${i.id}`} value={i.id} checked={idx === 0} class="sr-only" />
        <label for={`${name}-${i.id}`} role="tab">{i.label}</label>
      </>
    ))}
  </div>
  {INSTALLS.map((i) => (
    <div class="pane" data-pane={i.id} role="tabpanel">
      <CopyCommand label={`Install on ${i.label}`} command={i.command} />
      {!compact && <p class="small muted note">{i.note} Then run <code>ot doctor</code>.</p>}
    </div>
  ))}
</div>

<script>
  // Pick the visitor's platform; the first tab stays selected when it cannot be told.
  const ua = navigator.userAgent;
  const pick = /Windows/i.test(ua) ? "windows" : /Mac|Linux|X11/i.test(ua) ? "unix" : null;
  if (pick) {
    for (const r of document.querySelectorAll<HTMLInputElement>("[data-install] input[type=radio]")) r.checked = r.value === pick;
  }
</script>

<style>
  .install { display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr); }
  .tabs { max-width: 100%; }
  .tabs label { cursor: pointer; padding: 6px 12px; border-radius: 7px; color: var(--text-muted); font-size: var(--fs-1); font-weight: 550; transition: background var(--dur-1), color var(--dur-1), box-shadow var(--dur-1); }
  .tabs label:hover { color: var(--text); }
  .tabs input:focus-visible + label { box-shadow: var(--ring); }
  .pane { display: none; }
  .note { margin: 6px 2px 0; }
  .install:has(#os-unix:checked) [data-pane="unix"], .install:has(#os-windows:checked) [data-pane="windows"],
  .install:has(#os-brew:checked) [data-pane="brew"], .install:has(#os-scoop:checked) [data-pane="scoop"], .install:has(#os-go:checked) [data-pane="go"],
  .install:has(#cta-unix:checked) [data-pane="unix"], .install:has(#cta-windows:checked) [data-pane="windows"],
  .install:has(#cta-brew:checked) [data-pane="brew"], .install:has(#cta-scoop:checked) [data-pane="scoop"], .install:has(#cta-go:checked) [data-pane="go"] { display: block; animation: fade-in var(--dur-2) var(--ease-out); }
  .tabs:has(#os-unix:checked) label[for="os-unix"], .tabs:has(#os-windows:checked) label[for="os-windows"], .tabs:has(#os-brew:checked) label[for="os-brew"],
  .tabs:has(#os-scoop:checked) label[for="os-scoop"], .tabs:has(#os-go:checked) label[for="os-go"],
  .tabs:has(#cta-unix:checked) label[for="cta-unix"], .tabs:has(#cta-windows:checked) label[for="cta-windows"], .tabs:has(#cta-brew:checked) label[for="cta-brew"],
  .tabs:has(#cta-scoop:checked) label[for="cta-scoop"], .tabs:has(#cta-go:checked) label[for="cta-go"] { background: var(--bg-raised); color: var(--text); box-shadow: var(--shadow-1); }
  @keyframes fade-in { from { opacity: 0; translate: 0 6px; } }
</style>
