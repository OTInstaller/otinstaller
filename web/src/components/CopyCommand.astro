---
// A one-line command with a copy button. The click handler lives in Base.astro (one listener for every copy button).
interface Props {
  command: string;
  label?: string;
  class?: string;
}
const { command, label = "Command", class: cls } = Astro.props;
---
<div class:list={["cmd", cls]} role="group" aria-label={label}>
  <code>{command}</code>
  <button class="btn copy" type="button" data-copy={command} aria-label={`Copy: ${command}`}><span class="label">Copy</span></button>
</div>
