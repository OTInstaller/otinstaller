---
// How a release gets into the registry: five checks drawn as a pipeline whose line fills as it scrolls into view.
const steps = [
  { title: "Pinned", text: "Images by digest, wheels by hash. A version can never point at different code later." },
  { title: "Signed", text: "Signed by the repository's own CI with cosign keyless. ot checks the identity before every run." },
  { title: "Scanned", text: "Trivy for vulnerabilities and secrets, GuardDog for Python packages, and an SBOM." },
  { title: "Smoke-tested", text: "Run once with its declared test input, offline, in the same sandbox you will use." },
  { title: "Reviewed", text: "A person reviews every new publisher's first release against the acceptable-use rules." },
];
---
<ol class="pipe reveal stagger" aria-label="Checks every release goes through">
  {steps.map((s, i) => (
    <li class="node">
      <span class="dot" aria-hidden="true"><span class="n">{i + 1}</span></span>
      <h3>{s.title}</h3>
      <p class="small muted">{s.text}</p>
    </li>
  ))}
</ol>

<style>
  .pipe { position: relative; list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .pipe::before, .pipe::after { content: ""; position: absolute; top: 19px; left: 10%; right: 10%; height: 2px; border-radius: 2px; }
  .pipe::before { background: var(--border); }
  .pipe::after { background: linear-gradient(90deg, var(--accent), var(--ok)); transform-origin: left; scale: 0 1; transition: scale 1.6s var(--ease-out) 150ms; }
  .pipe.in::after { scale: 1 1; }
  .node { position: relative; text-align: center; padding: 0 6px; }
  .dot { position: relative; display: grid; place-items: center; width: 40px; height: 40px; margin: 0 auto 14px; border-radius: 50%; background: var(--bg-raised); border: 2px solid var(--border-strong); color: var(--text-muted); font-family: var(--font-mono); font-weight: 700; font-size: 0.85rem; transition: border-color var(--dur-3), color var(--dur-3), box-shadow var(--dur-3), scale var(--dur-3) var(--ease-spring); transition-delay: calc(var(--i, 0) * 260ms + 300ms); }
  .pipe.in .dot { border-color: var(--accent); color: var(--accent); box-shadow: 0 0 0 6px rgb(var(--accent-rgb) / 12%), 0 0 24px -4px rgb(var(--accent-rgb) / 60%); scale: 1.06; }
  .pipe.in .node:last-child .dot { border-color: var(--ok); color: var(--ok); box-shadow: 0 0 0 6px rgb(var(--ok-rgb) / 12%), 0 0 24px -4px rgb(var(--ok-rgb) / 60%); }
  .node h3 { margin: 0 0 4px; font-size: var(--fs-2); }
  .node p { margin: 0; }
  @media (max-width: 860px) {
    .pipe { grid-template-columns: 1fr; gap: 18px; padding-left: 4px; }
    .pipe::before, .pipe::after { top: 8%; bottom: 8%; left: 19px; right: auto; width: 2px; height: auto; transform-origin: top; }
    .pipe::after { scale: 1 0; background: linear-gradient(180deg, var(--accent), var(--ok)); }
    .pipe.in::after { scale: 1 1; }
    .node { text-align: left; display: grid; grid-template-columns: 40px 1fr; column-gap: 16px; align-items: start; }
    .dot { margin: 0; grid-row: 1 / 3; }
    .node h3 { grid-column: 2; }
    .node p { grid-column: 2; }
  }
</style>
