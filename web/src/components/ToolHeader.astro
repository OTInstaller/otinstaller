---
// The header and tab bar shared by a tool's pages: name, version, summary, the notices that change a decision,
// and at most three badges. The evidence lives in the body of the page, not up here.
import type { ToolDetail } from "../lib/api";
import BumpRelease from "../islands/BumpRelease";
import { isWrapper } from "../lib/proposals";

interface Props {
  tool: ToolDetail;
  active: "overview" | "docs" | "versions" | "security" | "issues" | "changes";
  hasDocs: boolean;
}
const { tool: t, active, hasDocs } = Astro.props;
const ref = `${t.namespace}/${t.name}`;
// A wrapper's homepage is the project it wraps. When it is the package's own repository there is nothing to credit
// or claim, whatever the flag says (older rows were flagged by namespace alone).
const upstream = t.homepage && t.homepage !== t.repo_url ? t.homepage : null;
const wrapper = isWrapper(t);
const tabs = [
  { key: "overview", href: `/${ref}`, label: "Overview" },
  { key: "security", href: `/${ref}/security`, label: "Security" },
  { key: "versions", href: `/${ref}/versions`, label: "Versions" },
  ...(hasDocs ? [{ key: "docs", href: `/${ref}/docs`, label: "Docs" }] : []),
  { key: "issues", href: `/${ref}/issues`, label: t.community?.open_broken ? `Issues (${t.community.open_broken} broken)` : "Issues" },
  // Community wrappers take change proposals from their maintainers.
  ...(wrapper ? [{ key: "changes", href: `/${ref}/changes`, label: "Changes" }] : []),
];
// What the upstream watcher found when upstream itself changed.
const UPSTREAM_NOTE: Record<string, string> = {
  archived: "The upstream repository is archived, so no new releases will come.",
  gone: "The upstream repository is gone.",
  license_changed: "The upstream project changed its license.",
};
// Where the community bot's bump of the pin stands.
const bump = t.upstream?.bump;
const day = (ms: number) => new Date(ms).toISOString().slice(0, 10);
---
<header class="tool-head">
  <nav class="small crumbs" aria-label="Breadcrumb">
    <a href="/search">Tools</a> <span aria-hidden="true">/</span> <a href={`/${t.namespace}`}>{t.namespace}</a>
  </nav>
  <div class="title-row">
    <h1>{t.name}</h1>
    <span class="ver">v{t.latest_version}</span>
    {t.verified && <span class="badge ok">Verified publisher</span>}
    {t.health === "broken" && <span class="badge warn">Possibly broken</span>}
    {t.status === "deprecated" && <span class="badge warn">Deprecated</span>}
  </div>
  <p class="lead">{t.summary}</p>
  {t.deprecated_message && (
    <p class="notice warn"><b>Deprecated.</b> {t.deprecated_message}{t.deprecated_replacement && <> Use <a href={`/${t.deprecated_replacement}`}>{t.deprecated_replacement}</a> instead.</>}</p>
  )}
  {wrapper && (
    <p class="notice small"><b>Community-packaged</b> from <a href={upstream!} rel="nofollow noopener">{upstream!.replace(/^https?:\/\//, "")}</a>: the registry's community pins the upstream release; the tool is its authors' work.{t.packaged_by && <> Packaged by <a href={`/people/${t.packaged_by}`}>{t.packaged_by}</a>{(t.maintainers ?? []).filter((m) => m !== t.packaged_by).length > 0 && <>, maintained with {(t.maintainers ?? []).filter((m) => m !== t.packaged_by).map((m, i) => <>{i > 0 && ", "}<a href={`/people/${m}`}>{m}</a></>)}</>}.</>} Maintain that project? <a href={`/${ref}/claim`}>Claim this package</a>.{t.upstream?.state === "behind" && !t.upstream.commits_behind && t.upstream.latest && <> Upstream has released <b>{t.upstream.latest}</b>; this package pins {t.upstream.pinned}.</>}{t.upstream && UPSTREAM_NOTE[t.upstream.state] && <> {UPSTREAM_NOTE[t.upstream.state]}</>}{bump?.status === "open" && <> <a href={bump.url} rel="nofollow noopener">A pull request bumps it to {bump.version}</a>.{bump.auto_release_at && <> It is released on its own on {day(bump.auto_release_at)} unless a maintainer stops it.</>}</>}{bump?.status === "merged" && <> The <a href={bump.url} rel="nofollow noopener">bump to {bump.version}</a> is being built and scanned{bump.released_version && <> as version {bump.released_version}</>}.</>}{bump?.status === "failed" && <> The release of the <a href={bump.url} rel="nofollow noopener">bump to {bump.version}</a> didn't go through; its maintainers can release it again.</>}{bump?.status === "released" && <> Bumped to {bump.version}{bump.released_version && <> in version {bump.released_version}</>}.</>}</p>
  )}
  {wrapper && bump && <BumpRelease client:idle refName={ref} />}
  {t.manifest_held_by_registry && <p class="notice small"><b>Manifest held by the registry.</b> The repository has no <code>otinstaller.yaml</code> yet, so releases are unsigned until it is added.</p>}
  {t.source_unavailable && <p class="notice bad"><b>Source unavailable.</b> The repository is gone or private. Installed copies keep working, but no new versions will come.</p>}
  <nav class="tabs" aria-label="Tool sections">
    {tabs.map((tab) => <a href={tab.href} aria-current={tab.key === active ? "page" : undefined}>{tab.label}</a>)}
  </nav>
</header>

<style>
  .tool-head { margin-bottom: 24px; }
  .crumbs { margin: 0 0 8px; color: var(--text-faint); display: flex; gap: 8px; }
  .crumbs a { color: var(--text-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--text); text-decoration: underline; }
  .title-row { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  h1 { margin: 0; font-size: var(--fs-6); word-break: break-word; }
  .ver { color: var(--text-muted); }
  .lead { margin: 8px 0 10px; }
  .notice { margin: 10px 0 0; max-width: 90ch; }
  .notice b { font-weight: 600; }
  .tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--border); margin-top: 20px; overflow-x: auto; scrollbar-width: none; }
  .tabs a { padding: 10px 14px; text-decoration: none; color: var(--text-muted); white-space: nowrap; transition: color var(--dur-1); }
  .tabs a:hover { color: var(--text); }
  .tabs a[aria-current="page"] { color: var(--text); box-shadow: inset 0 -2px 0 var(--text); }
</style>
