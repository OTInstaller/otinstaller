---
// The header and tab bar shared by a tool's pages.
import Badges from "./Badges.astro";
import type { ToolDetail } from "../lib/api";
import { formatCount } from "../lib/format";

interface Props {
  tool: ToolDetail;
  active: "overview" | "docs" | "versions" | "security";
  hasDocs: boolean;
  scanStatus?: string;
}
const { tool: t, active, hasDocs, scanStatus } = Astro.props;
const ref = `${t.namespace}/${t.name}`;
const tabs = [
  { key: "overview", href: `/${ref}`, label: "Overview" },
  ...(hasDocs ? [{ key: "docs", href: `/${ref}/docs`, label: "Docs" }] : []),
  { key: "versions", href: `/${ref}/versions`, label: "Versions" },
  { key: "security", href: `/${ref}/security`, label: "Security" },
];
---
<header class="tool-head">
  <p class="small muted crumbs"><a href={`/${t.namespace}`}>{t.namespace}</a> /</p>
  <h1>{t.name} <span class="ver muted">v{t.latest_version}</span></h1>
  <p class="lead">{t.summary}</p>
  <Badges tool={t} scanStatus={scanStatus} />
  <p class="small muted stats">★ {formatCount(t.stars)} stars · {formatCount(t.installs_30d)} installs in the last 30 days</p>
  {t.deprecated_message && <p class="notice warn">Deprecated: {t.deprecated_message}</p>}
  {t.source_unavailable && <p class="notice bad">The source repository is gone or private. Installed copies keep working, but no new versions will come.</p>}
  <nav class="tabs" aria-label="Tool sections">
    {tabs.map((tab) => <a href={tab.href} aria-current={tab.key === active ? "page" : undefined}>{tab.label}</a>)}
  </nav>
</header>

<style>
  .tool-head { margin-bottom: 20px; }
  .crumbs { margin: 0; }
  h1 { margin: 0.1em 0 0.2em; word-break: break-word; }
  .ver { font-size: 1rem; font-weight: 500; }
  .lead { font-size: 1.08rem; margin: 0 0 10px; }
  .stats { margin: 8px 0 0; }
  .tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--border); margin-top: 18px; overflow-x: auto; }
  .tabs a { padding: 8px 12px; text-decoration: none; color: var(--text-muted); border-bottom: 2px solid transparent; margin-bottom: -1px; white-space: nowrap; }
  .tabs a[aria-current="page"] { color: var(--text); border-color: var(--accent); font-weight: 600; }
</style>
