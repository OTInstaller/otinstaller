---
// The hero demo: a terminal that types an `ot run` once and shows its result, a real first run of dns-records on
// 21 Oct 2026 (digest and output verbatim, the install lines as ot v0.13.1 prints them). The server renders the
// finished frame, so bots, readers without JavaScript and people who prefer reduced motion see the full output.
---
<figure class="term" data-term aria-label="Example: running an OSINT tool with ot">
  <figcaption class="term-bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="title">ot — zsh</span>
  </figcaption>
  <pre class="term-body" aria-live="off"><code><span class="line prompt"><span class="ps">$</span> <span class="typed" data-typed>ot run osintverse-community/dns-records d:example.com --format table</span></span>
<span class="line dim" data-step>Installing osintverse-community/dns-records 0.1.0 (docker tool)…</span>
<span class="line dim" data-step>pulled ghcr.io/osintverse-community/dns-records@sha256:bdd911ffbc78…</span>
<span class="line ok" data-step>signature verified: signed by github.com/osintverse-community/dns-records</span>
<span class="line dim" data-step>Saved results/dns-records/example.com/20261021-175915_dns-records_example.com.json</span>
<span class="line hit" data-step>TYPE        VALUE                        SOURCE  CONFIDENCE</span>
<span class="line hit" data-step>dns_record  A 172.66.147.243             dns     high</span>
<span class="line hit" data-step>dns_record  MX 0 .                       dns     high</span>
<span class="line hit" data-step>dns_record  NS hera.ns.cloudflare.com.   dns     high</span>
<span class="line hit" data-step>dns_record  TXT "v=spf1 -all"            dns     high</span></code></pre>
</figure>

<script>
  const term = document.querySelector<HTMLElement>("[data-term]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (term && !reduce) {
    const typed = term.querySelector<HTMLElement>("[data-typed]")!;
    const steps = [...term.querySelectorAll<HTMLElement>("[data-step]")];
    const command = typed.textContent ?? "";
    let timer: number | undefined;
    let running = false;
    let visible = false;
    let done = false;

    const wait = (ms: number) => new Promise<void>((r) => (timer = window.setTimeout(r, ms)));
    const stop = () => {
      running = false;
      if (timer) clearTimeout(timer);
      term.removeAttribute("data-anim");
      typed.textContent = command;
      typed.classList.remove("typing");
      for (const s of steps) s.classList.add("show");
    };
    const loop = async () => {
      running = true;
      while (running) {
        term.setAttribute("data-anim", "");
        for (const s of steps) s.classList.remove("show");
        typed.textContent = "";
        typed.classList.add("typing");
        await wait(500);
        for (const ch of command) {
          if (!running) return;
          typed.textContent += ch;
          await wait(ch === " " ? 70 : 26 + Math.random() * 38);
        }
        await wait(380);
        typed.classList.remove("typing");
        const gaps = [320, 260, 420, 180, 160, 170, 190, 360];
        for (let i = 0; i < steps.length; i++) {
          if (!running) return;
          await wait(gaps[i] ?? 200);
          steps[i]!.classList.add("show");
        }
        running = false;
        done = true;
        term.removeAttribute("data-anim");
      }
    };
    const update = () => {
      const shouldRun = visible && !document.hidden;
      if (shouldRun && !running && !done) loop();
      if (!shouldRun && running) stop();
    };
    new IntersectionObserver(
      (es) => {
        visible = es.some((e) => e.isIntersecting);
        update();
      },
      { threshold: 0.3 },
    ).observe(term);
    document.addEventListener("visibilitychange", update);
  }
</script>

<style>
  .term { margin: 0; background: var(--code-bg); color: var(--code-text); border: 1px solid var(--border-strong); font-size: var(--fs-1); }
  .term-bar { display: flex; align-items: center; gap: 12px; padding: 8px 12px; border-bottom: 1px solid var(--code-border); color: var(--code-muted); font-size: var(--fs-0); }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 9px; height: 9px; background: var(--code-border); }
  .title { flex: 1; text-align: center; padding-right: 39px; }
  .term-body { margin: 0; padding: 14px 16px; line-height: 1.7; min-height: 14.4em; white-space: pre; overflow-x: auto; font-size: inherit; tab-size: 2; }
  .line { display: block; }
  .ps { color: var(--code-accent); }
  .typed { color: #fff; }
  .typed.typing::after { content: ""; display: inline-block; width: 0.55em; height: 1.05em; margin-left: 2px; vertical-align: -0.18em; background: var(--code-accent); }
  .ok b { color: var(--code-ok); font-weight: 700; }
  .dim, .line .dim { color: var(--code-muted); }
  .hit .tag { color: var(--code-ok); }
  .miss { color: var(--code-muted); }
  .miss .tag { color: var(--code-muted); }
  /* While typing, hidden steps stay in flow (no layout shift) and appear when shown. */
  .term[data-anim] [data-step] { visibility: hidden; }
  .term[data-anim] [data-step].show { visibility: visible; }
</style>
