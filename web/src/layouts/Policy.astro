---
// Layout for /policy pages.
import Base from "./Base.astro";
import SideNav from "../components/SideNav.astro";

interface Props {
  frontmatter: { title: string; description?: string; updated?: string };
  headings?: { depth: number; slug: string; text: string }[];
}
const { frontmatter, headings = [] } = Astro.props;
const pages: [string, string][] = [
  ["/policy/acceptable-use", "Acceptable use"],
  ["/policy/terms", "Terms of service"],
  ["/policy/privacy", "Privacy"],
  ["/policy/takedown", "Reports and takedowns"],
  ["/policy/transparency", "Transparency"],
];
const path = Astro.url.pathname.replace(/\/$/, "");
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=3600");
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="policy">
    <SideNav label="Policies" pages={pages} current={path} headings={headings} />
    <article class="prose policy-body">
      <p class="eyebrow">Policy</p>
      <h1>{frontmatter.title}</h1>
      {frontmatter.updated && <p class="small muted updated">Last updated {frontmatter.updated}</p>}
      <slot />
    </article>
  </div>
</Base>

<style>
  .policy { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 48px; align-items: start; }
  @media (max-width: 860px) { .policy { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
  .policy-body { max-width: 760px; }
  .policy-body .eyebrow { margin: 0; }
  .policy-body h1 { margin-top: 0.2em; }
  .updated { margin: -0.4em 0 1.6em; }
</style>
