---
// Layout for /policy pages.
import Base from "./Base.astro";

interface Props {
  frontmatter: { title: string; description?: string; updated?: string };
}
const { frontmatter } = Astro.props;
const pages = [
  ["/policy/acceptable-use", "Acceptable use"],
  ["/policy/terms", "Terms of service"],
  ["/policy/privacy", "Privacy"],
  ["/policy/takedown", "Reports and takedowns"],
  ["/policy/transparency", "Transparency"],
];
const path = Astro.url.pathname.replace(/\/$/, "");
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=3600");
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="policy">
    <nav aria-label="Policies" class="small">
      <ul class="list-plain">{pages.map(([href, label]) => <li><a href={href} aria-current={path === href ? "page" : undefined}>{label}</a></li>)}</ul>
    </nav>
    <article class="prose">
      <h1>{frontmatter.title}</h1>
      {frontmatter.updated && <p class="small muted">Last updated {frontmatter.updated}</p>}
      <slot />
    </article>
  </div>
</Base>

<style>
  .policy { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 32px; align-items: start; }
  @media (max-width: 860px) { .policy { grid-template-columns: minmax(0, 1fr); } }
  nav { position: sticky; top: 12px; }
  nav a { display: block; padding: 4px 8px; border-radius: var(--radius-sm); text-decoration: none; color: var(--text); }
  nav a[aria-current="page"] { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  article { max-width: 760px; }
</style>
