---
// The HTML shell: head, header with account state, main, lean footer, and the site-wide client code (copy
// buttons, the account menu). No content is hidden waiting for JavaScript and nothing animates on its own.
import "../styles/global.css";
import { Font } from "astro:assets";
import { SITE_URL } from "../lib/api";
import { THEME_BOOT } from "../lib/theme-boot";
import Logo from "../components/Logo.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import BetaNotice from "../components/BetaNotice.astro";
import SearchDialog from "../islands/SearchDialog";

interface Props {
  title: string;
  description?: string;
  /** Path for the canonical URL; defaults to the current path. */
  canonical?: string;
  /** schema.org JSON-LD for the page. */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Full-bleed pages (the home page) draw their own sections. */
  bleed?: boolean;
  /** The API route that holds this page's data, linked as its JSON twin. */
  jsonHref?: string;
  /** URL of the page's Markdown twin, announced as a rel="alternate" link for agents. */
  markdown?: string;
}
const { title, description = "Find, install and run OSINT tools and investigation guides with one command.", canonical, jsonLd, noindex, bleed = false, jsonHref, markdown } = Astro.props;
const fullTitle = title === "OTInstaller Registry" ? "OTInstaller — the OSINT tool registry" : `${title} · OTInstaller`;
const canonicalUrl = `${SITE_URL}${canonical ?? Astro.url.pathname}`;
const path = Astro.url.pathname;
const nav = [
  { href: "/search", label: "Tools" },
  { href: "/guides", label: "Guides" },
  { href: "/docs", label: "Docs" },
  { href: "/publish", label: "Publish" },
];
const isCurrent = (href: string) =>
  path === href || path.startsWith(href + "/") || (href === "/search" && (path.startsWith("/input/") || path.startsWith("/category/"))) || (href === "/publish" && path.startsWith("/import"));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={THEME_BOOT} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    {(noindex || Astro.url.search !== "") && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:site_name" content="OTInstaller" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${SITE_URL}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OTInstaller: paste what you have, run the right OSINT tool" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonHref && <link rel="alternate" type="application/json" href={jsonHref} />}
    <Font cssVariable="--font-geist" preload />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <BetaNotice />
    <header class="site-header glass" data-header>
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="OTInstaller home">
          <span class="mark"><Logo size={16} /></span>
          <span class="word">OTInstaller</span>
        </a>
        <nav class="main-nav" aria-label="Main">
          <ul>
            {nav.map((n) => <li><a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a></li>)}
          </ul>
        </nav>
        <div class="tools">
          <button class="search-btn" type="button" data-open-search aria-label="Search, or paste a value (press / or Ctrl K)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
            <span class="hint">Search or paste a value</span>
            <kbd class="kbd">/</kbd>
          </button>
          <ThemeToggle />
          <a class="btn btn-sm acct" href="/dashboard" data-signin aria-current={path.startsWith("/dashboard") ? "page" : undefined}>Sign in</a>
          <details class="menu acct-menu" data-account hidden>
            <summary><span class="login" data-login>account</span> <span aria-hidden="true">▾</span></summary>
            <ul class="list-plain">
              <li><a href="/dashboard">Dashboard</a></li>
              <li data-staff hidden><a href="/admin">Admin</a></li>
              <li><a href="/settings/accounts">Accounts</a></li>
              <li><a href="/feedback">Feedback</a></li>
            </ul>
          </details>
          <details class="menu nav-menu">
            <summary aria-label="Menu"><span class="burger" aria-hidden="true"><i></i><i></i><i></i></span></summary>
            <ul class="list-plain">
              {nav.map((n) => <li><a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a></li>)}
              <li><a href="/dashboard" data-signin-mobile>Sign in</a></li>
              <li data-staff hidden><a href="/admin">Admin</a></li>
            </ul>
          </details>
        </div>
      </div>
    </header>
    <main id="main">
      {bleed ? <slot /> : <div class="wrap"><slot /></div>}
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-brand">
            <p class="eyebrow">OTInstaller</p>
            <p class="small muted">A free registry of OSINT tools and investigation guides, and <code>ot</code>, the command that runs them on your own machine. By <a href="https://osintverse.com" rel="noopener">OSINTverse</a>.</p>
          </div>
          <div>
            <p class="eyebrow">Use</p>
            <ul class="list-plain small">
              <li><a href="/search">All tools</a></li>
              <li><a href="/guides">Guides</a></li>
              <li><a href="/docs/getting-started">Install ot</a></li>
              <li><a href="/docs/cli">CLI reference</a></li>
              <li><a href="/docs/automation">Scripts and agents</a></li>
              {jsonHref ? <li><a href={jsonHref}>This page as JSON</a>{markdown && <> · <a href={markdown}>Markdown</a></>}</li> : <li><a href="/llms.txt">llms.txt</a></li>}
            </ul>
          </div>
          <div>
            <p class="eyebrow">Publish</p>
            <ul class="list-plain small">
              <li><a href="/publish">How publishing works</a></li>
              <li><a href="/import">Import a repository</a></li>
              <li><a href="/docs/manifest">Manifest reference</a></li>
              <li><a href="/docs/guides">Writing guides</a></li>
            </ul>
          </div>
          <div>
            <p class="eyebrow">Trust</p>
            <ul class="list-plain small">
              <li><a href="/docs/security">Security model</a></li>
              <li><a href="/policy/transparency">Transparency</a></li>
              <li><a href="/policy/takedown">Reports and takedowns</a></li>
              <li><a href="/policy/privacy">Privacy</a> · <a href="/policy/terms">Terms</a> · <a href="/policy/acceptable-use">Acceptable use</a></li>
              <li><a href="mailto:security@otinstaller.com">security@otinstaller.com</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-bar small muted">
          <span>© {new Date().getFullYear()} OSINTverse · Apache-2.0 · <a href="https://github.com/OTInstaller/otinstaller" rel="noopener">Source</a></span>
          <span><a href="/feedback">Feedback</a> · <a href="mailto:support@otinstaller.com">Contact</a></span>
        </div>
      </div>
    </footer>
    <SearchDialog client:idle />
  </body>
</html>

<script>
  import { API_URL } from "../lib/api";

  // One copy handler for every copy button on the site.
  document.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-copy]");
    if (!btn) return;
    const label = btn.querySelector(".label") ?? btn;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? "");
      btn.dataset.state = "copied";
      label.textContent = "Copied";
    } catch {
      label.textContent = "Select it";
    }
    setTimeout(() => {
      delete btn.dataset.state;
      label.textContent = "Copy";
    }, 1600);
  });

  // Account state in the header. /me is asked once per tab every 10 minutes (the session cookie is httpOnly, so
  // there is no cheaper way to know); signing in or out on the dashboard refreshes the answer.
  const ACCOUNT_KEY = "ot-account";
  const show = (login: string | null, staff: boolean) => {
    for (const el of document.querySelectorAll<HTMLElement>("[data-staff]")) el.hidden = !staff;
    for (const el of document.querySelectorAll<HTMLElement>("[data-signin]")) el.hidden = !!login;
    for (const el of document.querySelectorAll<HTMLElement>("[data-account]")) el.hidden = !login;
    for (const el of document.querySelectorAll<HTMLElement>("[data-login]")) el.textContent = login ?? "";
    for (const el of document.querySelectorAll<HTMLAnchorElement>("[data-signin-mobile]")) el.textContent = login ? `Dashboard (${login})` : "Sign in";
  };
  try {
    const cached = JSON.parse(sessionStorage.getItem(ACCOUNT_KEY) ?? "null") as { login: string | null; staff: boolean; at: number } | null;
    if (cached && Date.now() - cached.at < 10 * 60 * 1000) show(cached.login, cached.staff);
    else
      fetch(`${API_URL}/v1/me`, { credentials: "include" })
        .then((r) => (r.ok ? r.json() : null))
        .then((me: { login?: string; admin?: boolean; reviewer?: boolean } | null) => {
          const login = me?.login ?? null;
          const staff = !!(me && (me.admin || me.reviewer));
          show(login, staff);
          sessionStorage.setItem(ACCOUNT_KEY, JSON.stringify({ login, staff, at: Date.now() }));
        })
        .catch(() => {});
  } catch {
    // Storage unavailable (private mode): the header stays signed out rather than asking on every page.
  }

  // Close open menus when clicking outside.
  document.addEventListener("click", (e) => {
    for (const menu of document.querySelectorAll<HTMLDetailsElement>("details.menu[open]")) {
      if (!menu.contains(e.target as Node)) menu.open = false;
    }
  });
</script>

<style>
  [hidden] { display: none !important; }
  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--border); }
  .bar { display: flex; align-items: center; gap: 24px; min-height: 57px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; color: var(--text); text-decoration: none; }
  .mark { display: grid; place-items: center; width: 22px; height: 22px; background: var(--bg-inverse); color: var(--bg); }
  .main-nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .main-nav a { display: block; padding: 8px 10px; color: var(--text-muted); text-decoration: none; transition: color var(--dur-1); }
  .main-nav a:hover { color: var(--text); }
  .main-nav a[aria-current="page"] { color: var(--text); box-shadow: inset 0 -2px 0 var(--text); }
  .tools { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .search-btn { display: inline-flex; align-items: center; gap: 10px; height: 36px; padding: 0 10px; border: 1px solid var(--border-strong); background: transparent; color: var(--text-muted); min-width: 220px; transition: border-color var(--dur-1), color var(--dur-1); }
  .search-btn:hover { border-color: var(--text); color: var(--text); }
  .search-btn svg { width: 16px; height: 16px; }
  .search-btn .hint { text-align: left; flex: 1; font-size: var(--fs-1); }
  .acct { font-weight: 500; }
  .menu { position: relative; }
  .menu summary { list-style: none; display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 10px; border: 1px solid var(--border-strong); cursor: pointer; font-size: var(--fs-1); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary:hover { border-color: var(--text); }
  .nav-menu { display: none; }
  .nav-menu summary { width: 36px; padding: 0; justify-content: center; }
  .burger { display: grid; gap: 4px; }
  .burger i { display: block; width: 16px; height: 2px; background: var(--text); }
  .menu ul { position: absolute; right: 0; top: calc(100% + 6px); min-width: 200px; padding: 4px; border: 1px solid var(--border-strong); background: var(--bg); z-index: 60; }
  .menu:not([open]) ul { display: none; }
  .menu li + li { margin-top: 0; }
  .menu ul a { display: block; padding: 8px 10px; text-decoration: none; color: var(--text); }
  .menu ul a:hover, .menu ul a[aria-current="page"] { background: var(--bg-subtle); }
  @media (max-width: 820px) {
    .main-nav, .acct, .acct-menu, .search-btn .hint, .search-btn .kbd { display: none; }
    .search-btn { min-width: 0; width: 36px; padding: 0; justify-content: center; }
    .nav-menu { display: block; }
  }

  .site-footer { border-top: 1px solid var(--border); padding: 40px 0 24px; }
  .foot-grid { display: grid; gap: 24px; grid-template-columns: 1.5fr repeat(3, minmax(0, 1fr)); }
  .foot-grid .eyebrow { margin: 0 0 10px; color: var(--text); }
  .foot-grid li + li { margin-top: 6px; }
  .foot-grid a { color: var(--text-muted); text-decoration: none; }
  .foot-grid a:hover { color: var(--text); text-decoration: underline; }
  .foot-brand p:not(.eyebrow) { max-width: 40ch; margin: 0; }
  .foot-bar { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; border-top: 1px solid var(--border); margin-top: 28px; padding-top: 16px; }
  @media (max-width: 820px) { .foot-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .foot-brand { grid-column: 1 / -1; } }
</style>
