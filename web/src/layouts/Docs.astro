---
// Layout for the Markdown pages under /docs.
import Base from "./Base.astro";
import SideNav from "../components/SideNav.astro";
import CopyCode from "../components/CopyCode.astro";

interface Props {
  frontmatter: { title: string; description?: string };
  headings?: { depth: number; slug: string; text: string }[];
}
const { frontmatter, headings = [] } = Astro.props;
const pages: [string, string][] = [
  ["/docs", "Overview"],
  ["/docs/getting-started", "Getting started"],
  ["/docs/cli", "CLI reference"],
  ["/docs/manifest", "Manifest reference"],
  ["/docs/publishing", "Publishing"],
  ["/docs/guides", "Guides and tool docs"],
  ["/docs/errors", "Error codes"],
  ["/docs/security", "Security model"],
  ["/docs/faq", "FAQ"],
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/docs";
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=3600");
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="docs">
    <SideNav label="Documentation" pages={pages} current={path} headings={headings} />
    <article class="prose doc-body">
      <p class="eyebrow">Docs</p>
      <h1>{frontmatter.title}</h1>
      {frontmatter.description && <p class="lead">{frontmatter.description}</p>}
      <slot />
    </article>
  </div>
  <CopyCode />
</Base>

<style>
  .docs { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 48px; align-items: start; }
  @media (max-width: 860px) { .docs { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
  .doc-body { max-width: 760px; }
  .doc-body .eyebrow { margin: 0; }
  .doc-body h1 { margin-top: 0.2em; }
  .doc-body .lead { margin-top: 0; margin-bottom: 1.6em; }
</style>
