---
// Layout for the Markdown pages under /docs.
import Base from "./Base.astro";

interface Props {
  frontmatter: { title: string; description?: string };
}
const { frontmatter } = Astro.props;
const pages = [
  ["/docs", "Overview"],
  ["/docs/getting-started", "Getting started"],
  ["/docs/cli", "CLI reference"],
  ["/docs/manifest", "Manifest reference"],
  ["/docs/publishing", "Publishing"],
  ["/docs/guides", "Guides and tool docs"],
  ["/docs/errors", "Error codes"],
  ["/docs/security", "Security model"],
  ["/docs/faq", "FAQ"],
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/docs";
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=3600");
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="docs">
    <nav aria-label="Documentation" class="small">
      <ul class="list-plain">
        {pages.map(([href, label]) => <li><a href={href} aria-current={path === href ? "page" : undefined}>{label}</a></li>)}
      </ul>
    </nav>
    <article class="prose">
      <h1>{frontmatter.title}</h1>
      <slot />
    </article>
  </div>
</Base>

<style>
  .docs { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 32px; align-items: start; }
  @media (max-width: 860px) { .docs { grid-template-columns: minmax(0, 1fr); } }
  nav { position: sticky; top: 12px; }
  nav a { display: block; padding: 4px 8px; border-radius: var(--radius-sm); text-decoration: none; color: var(--text); }
  nav a[aria-current="page"] { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  article { max-width: 760px; }
</style>
