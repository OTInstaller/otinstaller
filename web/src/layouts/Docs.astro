---
// Layout for the Markdown pages under /docs.
import Base from "./Base.astro";
import SideNav from "../components/SideNav.astro";
import { markdownPage } from "../lib/markdown";
import CopyCode from "../components/CopyCode.astro";
import { breadcrumbs, faqFromMarkdown, faqPage, graph, ORGANIZATION } from "../lib/seo";

interface Props {
  frontmatter: { title: string; description?: string };
  headings?: { depth: number; slug: string; text: string }[];
}
const { frontmatter, headings = [] } = Astro.props;
// In the order a newcomer reads them: start, use, understand results, publish, then the deeper references.
const pages: [string, string][] = [
  ["/docs", "Overview"],
  ["/docs/quick-start", "Quick start"],
  ["/docs/getting-started", "Getting started"],
  ["/docs/otlite", "otlite, without Docker"],
  ["/docs/cli", "CLI reference"],
  ["/docs/results", "Results and the envelope"],
  ["/docs/security", "Security model"],
  ["/docs/publishing", "Publishing"],
  ["/docs/manifest", "Manifest reference"],
  ["/docs/guides", "Guides and tool docs"],
  ["/docs/community", "Community"],
  ["/docs/errors", "Error codes"],
  ["/docs/agents", "AI agents and MCP"],
  ["/docs/mcp-tools", "MCP tools"],
  ["/docs/automation", "Scripts, CI and agents"],
  ["/docs/api", "Registry API"],
  ["/docs/faq", "FAQ"],
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/docs";
const source = markdownPage(path);
const twin = source ? `${path}.md` : undefined;
const idx = pages.findIndex(([href]) => href === path);
// The FAQ page's questions are real questions with real answers, so they are also offered as FAQPage data.
const faq = path === "/docs/faq" && source ? faqFromMarkdown(source.body) : [];
const jsonLd = graph(
  { "@type": "TechArticle", headline: frontmatter.title, description: frontmatter.description, url: `${Astro.site}${path.slice(1)}`, inLanguage: "en", author: ORGANIZATION, publisher: ORGANIZATION, isPartOf: { "@type": "WebSite", url: Astro.site?.toString() } },
  breadcrumbs([["Docs", "/docs"], ...(path !== "/docs" ? [[frontmatter.title, path] as [string, string]] : [])]),
  ...(faq.length ? [faqPage(faq)] : []),
);
const prev = idx > 0 ? pages[idx - 1] : null;
const next = idx >= 0 && idx < pages.length - 1 ? pages[idx + 1] : null;
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=3600");
---
<Base title={path === "/docs" ? "Documentation: install ot, run OSINT tools, publish your own" : frontmatter.title} description={frontmatter.description} markdown={twin} ogType="article" jsonLd={jsonLd}>
  <div class="docs">
    <SideNav label="Documentation" pages={pages} current={path} headings={headings} />
    <article class="prose doc-body">
      <p class="eyebrow">Docs</p>
      <h1>{frontmatter.title}</h1>
      {frontmatter.description && <p class="lead">{frontmatter.description}</p>}
      <slot />
      {(prev || next) && (
        <nav class="pager" aria-label="Docs pages">
          {prev ? <a class="pg" href={prev[0]} rel="prev"><span class="small muted">← Previous</span><strong>{prev[1]}</strong></a> : <span />}
          {next && <a class="pg next" href={next[0]} rel="next"><span class="small muted">Next →</span><strong>{next[1]}</strong></a>}
        </nav>
      )}
      {twin && <p class="small muted twin">This page as <a href={twin}>Markdown</a>.</p>}
    </article>
  </div>
  <CopyCode />
</Base>

<style>
  .docs { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 48px; align-items: start; }
  @media (max-width: 860px) { .docs { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
  .doc-body { max-width: 760px; }
  .doc-body .eyebrow { margin: 0; }
  .doc-body h1 { margin-top: 0.2em; }
  .doc-body .lead { margin-top: 0; margin-bottom: 1.6em; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 40px; border-top: 1px solid var(--border); padding-top: 20px; }
  .pg { display: grid; gap: 2px; padding: 12px 14px; border: 1px solid var(--border); text-decoration: none; color: var(--text); transition: border-color var(--dur-1); }
  .pg:hover { border-color: var(--text); }
  .pg.next { text-align: right; }
  .twin { margin-top: 16px; }
  @media (max-width: 600px) { .pager { grid-template-columns: 1fr; } .pg.next { text-align: left; } }
</style>
