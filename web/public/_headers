# Static-asset headers (Cloudflare Workers assets). Prerendered routes lose the headers their endpoints set, so the
# JSON Schemas get their media type and open CORS here. The adapter appends its own /_astro/* rule at build time.
/schema/*
  Content-Type: application/schema+json
  Access-Control-Allow-Origin: *

# The MCP Registry's HTTP domain check reads this public key (docs/publishing-setup.md, section 10).
/.well-known/mcp-registry-auth
  Content-Type: text/plain; charset=utf-8
