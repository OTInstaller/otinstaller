{
  "name": "otinstaller-registry-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply otinstaller --local",
    "db:seed": "node scripts/seed.mjs && wrangler d1 execute otinstaller --local --file=.wrangler/seed.sql",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "sync:templates": "node scripts/sync-templates.mjs",
    "sync:known-repos": "node scripts/sync-known-repos.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "hono": "^4.13.16",
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261106.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2",
    "vitest": "~5.1.0",
    "wrangler": "^4.158.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
