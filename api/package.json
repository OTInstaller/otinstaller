{
  "name": "otinstaller-registry-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply otinstaller --local",
    "db:seed": "node scripts/seed.mjs && wrangler d1 execute otinstaller --local --file=.wrangler/seed.sql",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261019.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3",
    "vitest": "~4.1.0",
    "wrangler": "^4.151.1",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261012.1": true
  }
}
