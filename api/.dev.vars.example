# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Sign in with OSINTverse; register http://localhost:8787/v1/auth/osintverse/callback as a redirect URI.
OSINTVERSE_CLIENT_ID=
OSINTVERSE_CLIENT_SECRET=
TOKEN_ENC_KEY=
SITE_URL=http://localhost:4321
API_URL=http://127.0.0.1:8787
# Optional: check guide links with Cloudflare URL Scanner (account ID and an API token with URL Scanner edit).
CF_URLSCAN_ACCOUNT_ID=
CF_URLSCAN_TOKEN=
# Shared with the nightly health workflow in registry-ops (any long random string).
HEALTH_TOKEN=
# Optional: report server errors to Sentry.
SENTRY_DSN=
