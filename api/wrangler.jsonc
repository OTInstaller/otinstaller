{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "otinstaller-registry-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare creates the DNS record for the custom domain on deploy.
  "routes": [{ "pattern": "api.otinstaller.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "otinstaller",
      "database_id": "77c26f27-5605-4e1f-a3e1-616acd3129d1",
      "migrations_dir": "migrations"
    }
  ],
  // Rendered READMEs, guide pages and tool docs. Create with `wrangler r2 bucket create otinstaller-content`.
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "otinstaller-content" }],
  "queues": {
    "producers": [{ "binding": "PUBLISH_QUEUE", "queue": "otinstaller-publish" }],
    "consumers": [{ "queue": "otinstaller-publish", "max_batch_size": 5, "max_retries": 5, "retry_delay": 30 }]
  },
  "triggers": { "crons": ["17 3 * * *", "*/15 * * * *"] },
  "vars": {
    "SITE_URL": "https://otinstaller.com",
    "API_URL": "https://api.otinstaller.com",
    "OPS_REPO": "OTInstaller/registry-ops",
    "EMAIL_FROM": "OTInstaller Registry <registry@otinstaller.com>"
    // "GITHUB_APP_SLUG": "otinstaller" is the App's URL name for install links (this is the default)
  }
  // Secrets (set with `wrangler secret put`, or in .dev.vars locally):
  //   GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY (PKCS#8 PEM), GITHUB_WEBHOOK_SECRET,
  //   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GITLAB_CLIENT_ID, GITLAB_CLIENT_SECRET,
  //   TOKEN_ENC_KEY (32 random bytes, base64), OPS_DISPATCH_TOKEN or OPS_INSTALLATION_ID, RESEND_API_KEY,
  //   CF_URLSCAN_ACCOUNT_ID and CF_URLSCAN_TOKEN (optional: URL Scanner checks of guide links; skipped when unset)
}
